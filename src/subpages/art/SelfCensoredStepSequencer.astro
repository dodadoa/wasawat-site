---
import ArtworkMeta from "../../components/art/ArtworkMeta.astro"

// hand-built anchor: the shared mention map renders @karnpapon as "Anu"
// (display name), which would collide with the artwork title "Anu" here
const inspiration =
  'Inspired by <em>Anu</em> by <a href="https://www.instagram.com/karnpapon/" target="_blank" rel="noopener noreferrer" class="ig-mention font-bold hover:underline" style="color: var(--text-muted);">@karnpapon</a> and some recent redacted documents you may have seen.'
---

<div class="mt-4 max-w-3xl">
  <ArtworkMeta fields={[
    { label: "Year", value: "2026" },
    { label: "Medium", value: "Net art · Chrome extension, website" },
  ]} />

  <p class="mb-6 art-lead">What cannot be said becomes the beat</p>

  <p class="mb-4">
    I made a Chrome extension — a step sequencer that turns redacted text into rhythm. In the age
    of blacked-out documents, what you cannot say becomes the beat. This extension turns that
    silence into music.
  </p>

  <p class="mb-6 opacity-70" set:html={inspiration}></p>

  <h2 class="uppercase text-[13px] tracking-widest mt-8 mb-4" style="color: var(--text-muted)">
    How It Works
  </h2>

  <ol class="mb-4 space-y-1" style="list-style: decimal; padding-left: 1.4em;">
    <li>Open any webpage. Click the extension and select an area of text.</li>
    <li>Highlight the words.</li>
    <li>
      Press play. The sequencer steps through your text, word by word, at your chosen BPM.
      Every redacted word glows and fires a drum sound.
    </li>
  </ol>

  <h2 class="uppercase text-[13px] tracking-widest mt-8 mb-4" style="color: var(--text-muted)">
    Sound Modes
  </h2>

  <ol class="mb-4 space-y-1" style="list-style: decimal; padding-left: 1.4em;">
    <li>
      Connect to your local sound engine via WebSocket and OSC — the <code>bridge.js</code> is
      provided in the repository.
    </li>
    <li>
      Play directly in the browser with preset sounds: kick, snare, hi-hat, open hat, and laser.
    </li>
  </ol>

  <h2 class="uppercase text-[13px] tracking-widest mt-8 mb-4" style="color: var(--text-muted)">
    Presentation Modes
  </h2>

  <ol class="mb-4 space-y-1" style="list-style: decimal; padding-left: 1.4em;">
    <li>Overlay</li>
    <li>Sidebar</li>
  </ol>

  <p class="mb-4 text-sm opacity-80">
    If you encounter any bugs, please report them or send a pull request on GitHub. Thank you.
  </p>

  <div class="mt-6 pt-4 text-sm" style="border-top: 1px solid var(--border-subtle); display: flex; flex-wrap: wrap; gap: 2rem;">
    <p>
      <strong>Chrome Web Store</strong><br />
      <a
        href="https://chromewebstore.google.com/detail/self-censored-step-sequen/ebechoeekjbgipgabcafpbfhenhpfaei"
        target="_blank"
        rel="noopener noreferrer"
        class="underline"
        style="color: var(--text-muted);"
      >
        Self-censored Step Sequencer
      </a>
    </p>
    <p>
      <strong>Repository</strong><br />
      <a
        href="https://github.com/dodadoa/redacted-dm"
        target="_blank"
        rel="noopener noreferrer"
        class="underline"
        style="color: var(--text-muted);"
      >
        github.com/dodadoa/redacted-dm
      </a>
    </p>
  </div>

  <div class="art-media-grid">
    <figure>
      <img
        src="/images/self-censored/overlay-wikipedia.webp"
        alt="Self-censored Step Sequencer overlay on a Wikipedia article, redacted words firing as steps"
        loading="lazy"
      />
      <figcaption class="mt-2 text-sm opacity-70">Overlay mode — word redaction in the browser</figcaption>
    </figure>

    <figure>
      <img
        src="/images/self-censored/sidepanel-wikipedia.webp"
        alt="Self-censored Step Sequencer side panel with Local Remote output over an OSC bridge"
        loading="lazy"
      />
      <figcaption class="mt-2 text-sm opacity-70">Side panel mode — Local Remote via WebSocket/OSC</figcaption>
    </figure>

    <figure class="art-media-full">
      <img
        src="/images/self-censored/modes.png"
        alt="Comparison of the two presentation modes: floating overlay and Chrome side panel"
        style="max-width: min(600px, 90%);"
        loading="lazy"
      />
      <figcaption class="mt-2 text-sm opacity-70">Presentation modes — overlay / side panel</figcaption>
    </figure>

    <figure>
      <video controls preload="metadata">
        <source src="/video/sss1.mp4" type="video/mp4" />
      </video>
      <figcaption class="mt-2 text-sm opacity-70">Local engine (WebSocket + OSC)</figcaption>
    </figure>

    <figure>
      <video controls preload="metadata">
        <source src="/video/sss2.mp4" type="video/mp4" />
      </video>
      <figcaption class="mt-2 text-sm opacity-70">Browser playback presets</figcaption>
    </figure>

    <figure>
      <video controls preload="metadata">
        <source src="/video/sss3.mp4" type="video/mp4" />
      </video>
      <figcaption class="mt-2 text-sm opacity-70">Layouts (overlay / sidebar)</figcaption>
    </figure>
  </div>
</div>
