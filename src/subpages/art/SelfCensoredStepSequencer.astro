---
import { linkInstagramMentions } from "../../utils/instagramMentions"

const inspiration = linkInstagramMentions("Inspired by Anu (@karnpapon) and recent redacted documents.")
---

<div class="mt-4 max-w-3xl">
  <p class="mb-6 text-sm opacity-80">What cannot be said becomes the beat</p>

  <p class="mb-4">
    A Chrome extension that turns redacted text into rhythm. Select a text area, highlight words or
    blacked-out fragments, set BPM and press play — the sequencer steps word-by-word, redacted words
    glow and trigger drum hits. Two sound modes (local WebSocket→OSC engine, or built-in browser
    presets) and two layouts (overlay / sidebar).
  </p>

  <p class="mb-6 text-sm opacity-80" set:html={inspiration}></p>

  <figure class="my-8">
    <img
      src="/images/self-censored-step-sequencer-chrome-extension.jpg"
      alt="Self-censored Step Sequencer Chrome extension screenshot"
      style="width: 100%; max-width: 340px; height: auto; display: block;"
      loading="lazy"
    />
  </figure>

  <div class="my-8 space-y-8">
    <figure>
      <video controls class="w-full" preload="metadata">
        <source src="/video/sss1.mp4" type="video/mp4" />
      </video>
      <figcaption class="mt-2 text-sm opacity-70">Local engine (WebSocket + OSC)</figcaption>
    </figure>

    <figure>
      <video controls class="w-full" preload="metadata">
        <source src="/video/sss2.mp4" type="video/mp4" />
      </video>
      <figcaption class="mt-2 text-sm opacity-70">Browser playback presets</figcaption>
    </figure>

    <figure>
      <video controls class="w-full" preload="metadata">
        <source src="/video/sss3.mp4" type="video/mp4" />
      </video>
      <figcaption class="mt-2 text-sm opacity-70">Layouts (overlay / sidebar)</figcaption>
    </figure>
  </div>

  <div class="mt-6 pt-4 text-sm" style="border-top: 1px solid var(--border-subtle); display: flex; flex-wrap: wrap; gap: 2rem;">
    <p>
      <strong>Chrome Web Store</strong><br />
      <a
        href="https://chromewebstore.google.com/detail/self-censored-step-sequen/ebechoeekjbgipgabcafpbfhenhpfaei"
        target="_blank"
        rel="noopener noreferrer"
        class="underline"
        style="color: var(--text-muted);"
      >
        Self-censored Step Sequencer
      </a>
    </p>
    <p>
      <strong>Repository</strong><br />
      <a
        href="https://github.com/dodadoa/redacted-dm"
        target="_blank"
        rel="noopener noreferrer"
        class="underline"
        style="color: var(--text-muted);"
      >
        github.com/dodadoa/redacted-dm
      </a>
    </p>
  </div>
</div>
