---
import ArtworkMeta from "../../components/art/ArtworkMeta.astro";

const SCATTER_COUNT = 30
const scatterImages = Array.from({ length: SCATTER_COUNT }, (_, i) =>
  `/images/byob-scatter/byob-${String(i + 1).padStart(2, "0")}.jpg`,
)
---

<!-- full-screen scattered background field -->
<div class="byob-bg-field" id="byob-bg-field" aria-hidden="true">
  {scatterImages.map((src, i) => (
    <img class="byob-bg-item" data-i={i} src={src} alt="" loading="lazy" decoding="async" />
  ))}
</div>

<div class="byob-textblock mt-4 max-w-3xl">
  <ArtworkMeta fields={[
    { label: "Year",   value: "2023" },
    { label: "Role",   value: "Organizer, Co-Director" },
    { label: "With",   value: "JAAG (Joint Artistic Amateur Group) & ZonZon.Studio" },
    { label: "Venue",  value: "Bangkok CityCity Gallery, Bangkok" },
    { label: "Type",   value: "One-night motion picture exhibition" },
  ]} />

  <p class="mb-4">
    BYOB (Bring Your Own Beamers) is a series of one-night motion picture exhibitions that take place
    in various locations around the world. Artists bring their own projectors and beamers to display
    their works, filling the space with projected images together.
  </p>

  <p class="mb-4">
    Originally started by Rafaël Rozendaal in Berlin in 2010, BYOB has since expanded across
    Amsterdam, Los Angeles, Melbourne, and Taipei. The open invitation format welcomes visual artists
    and creators to explore new possibilities in presenting moving images through projection.
  </p>

  <p class="mb-4">
    BYOB Bangkok was organised by JAAG (Joint Artistic Amateur Group) and ZonZon.Studio,
    with support from Bangkok CityCity Gallery.
  </p>
</div>

<!-- toolbar -->
<div class="byob-toolbar">
  <button id="byob-toggle" class="byob-btn" data-mode="scatter">
    <span class="byob-btn-label">↓ ARRANGE</span>
  </button>
  <span class="byob-mode-hint">scattered</span>
</div>

<!-- image field: starts in scatter mode (position:fixed applied by script) -->
<div class="byob-field" id="byob-field" data-mode="scatter">
  <div class="byob-item" data-i="0"><img src="/images/byob/poster.jpg"  alt="BYOB BKK 2023 — Poster" loading="lazy" /></div>
  <div class="byob-item" data-i="1"><img src="/images/byob/byob-1.jpg"  alt="BYOB BKK 2023" loading="lazy" /></div>
  <div class="byob-item" data-i="2"><img src="/images/byob/byob-3.jpg"  alt="BYOB BKK 2023" loading="lazy" /></div>
  <div class="byob-item" data-i="3"><img src="/images/byob/byob-4.jpg"  alt="BYOB BKK 2023" loading="lazy" /></div>
  <div class="byob-item" data-i="4"><img src="/images/byob/byob-5.jpg"  alt="BYOB BKK 2023" loading="lazy" /></div>
  <div class="byob-item" data-i="5"><img src="/images/byob/byob-6.jpg"  alt="BYOB BKK 2023" loading="lazy" /></div>
  <div class="byob-item" data-i="6"><img src="/images/byob/byob-10.jpg" alt="BYOB BKK 2023" loading="lazy" /></div>
  <div class="byob-item" data-i="7"><img src="/images/byob/byob-12.jpg" alt="BYOB BKK 2023" loading="lazy" /></div>
  <div class="byob-item" data-i="8"><img src="/images/byob/byob-16.jpg" alt="BYOB BKK 2023" loading="lazy" /></div>
  <div class="byob-item" data-i="9"><img src="/images/byob/byob-17.jpg" alt="BYOB BKK 2023" loading="lazy" /></div>
  {scatterImages.map((src, i) => (
    <div class="byob-item byob-extra-item" data-i={`extra-${i}`}><img src={src} alt="BYOB BKK 2023" loading="lazy" /></div>
  ))}
</div>
<button id="byob-load-more" class="byob-btn byob-load-more">↓ LOAD MORE</button>
<p class="byob-caption" id="byob-caption">BYOB Bangkok, 2023. Bangkok CityCity Gallery.</p>

<script>
  const field   = document.getElementById('byob-field') as HTMLElement;
  const btn     = document.getElementById('byob-toggle') as HTMLButtonElement;
  const hint    = btn.nextElementSibling as HTMLElement;
  const caption = document.getElementById('byob-caption') as HTMLElement;

  const bgFieldEl = document.getElementById('byob-bg-field') as HTMLElement | null;

  // ── apply scatter: hide the curated 10-image grid, show the true
  //    full-page scattered field (byob-bg-field) instead — having both
  //    on screen at once is what made things feel cramped, not scattered ──
  function applyScatter() {
    field.style.display = 'none';
    if (bgFieldEl) {
      bgFieldEl.style.transition = 'opacity 0.4s';
      bgFieldEl.style.opacity = '1';
      bgFieldEl.style.pointerEvents = '';
    }
    document.body.classList.add('byob-scatter');
  }

  // ── apply arrange: show curated grid, fade the scattered field out ──
  function applyArrange() {
    Object.assign(field.style, {
      position: '',
      top: '',
      left: '',
      width: '', // let the arrange-mode stylesheet rule (full-bleed 100vw) control this —
      height: '', // an inline style here would always win over CSS regardless of specificity
      zIndex: '',
      pointerEvents: '',
      display: '',
    });
    if (bgFieldEl) {
      bgFieldEl.style.transition = 'opacity 0.4s';
      bgFieldEl.style.opacity = '0';
      bgFieldEl.style.pointerEvents = 'none';
    }
    document.body.classList.remove('byob-scatter');
  }

  async function setMode(mode: 'scatter' | 'arrange', instant = false) {
    field.dataset.mode = mode;
    btn.dataset.mode   = mode;

    if (!instant) {
      // fade out
      field.style.transition = 'opacity 0.25s';
      field.style.opacity = '0';
      await new Promise<void>(r => setTimeout(r, 250));
    }

    if (mode === 'scatter') {
      applyScatter();
      btn.querySelector('.byob-btn-label')!.textContent = '↓ ARRANGE';
      hint.textContent = 'scattered';
      caption.style.display = 'none';
    } else {
      applyArrange();
      btn.querySelector('.byob-btn-label')!.textContent = '↑ SCATTER';
      hint.textContent = 'arranged';
      caption.style.display = '';
    }

    if (!instant) {
      field.style.opacity = '0';
      requestAnimationFrame(() => {
        field.style.transition = 'opacity 0.4s';
        field.style.opacity = '1';
      });
    }
  }

  // boot in scatter
  applyScatter();
  caption.style.display = 'none';

  btn.addEventListener('click', () => {
    const next = field.dataset.mode === 'scatter' ? 'arrange' : 'scatter';
    setMode(next as 'scatter' | 'arrange');
    updateLoadMoreVisibility();
  });

  // ── load more: arrange starts with the first 10 curated images only;
  //    the rest reveal on demand ──
  const loadMoreBtn = document.getElementById('byob-load-more') as HTMLButtonElement;
  let extrasRevealed = false;

  function updateLoadMoreVisibility() {
    const inArrange = field.dataset.mode === 'arrange';
    loadMoreBtn.style.display = (inArrange && !extrasRevealed) ? 'inline-block' : 'none';
  }

  loadMoreBtn.addEventListener('click', () => {
    extrasRevealed = true;
    field.classList.add('byob-extras-revealed');
    updateLoadMoreVisibility();
  });

  updateLoadMoreVisibility();

  // ── full-screen scatter background ──────────────────────────────────
  // deterministic PRNG so layout is stable across renders
  function mulberry32(a: number) {
    return function () {
      a |= 0; a = (a + 0x6d2b79f5) | 0;
      let t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  const bgField = document.getElementById('byob-bg-field');
  if (bgField) {
    const rand = mulberry32(20230520);
    const items = [...bgField.querySelectorAll<HTMLElement>('.byob-bg-item')];
    const pageHeight = () => Math.max(document.body.scrollHeight, window.innerHeight);

    // ── trickle reveal: start with just the first batch on screen, then
    //    drip in more as the user scrolls down (instead of dumping all 30
    //    at once, or revealing them on a blind timer) ──
    const REVEAL_BATCH = 10;
    const REVEAL_SCROLL_MARGIN_PX = 600; // start loading the next batch this far before hitting bottom
    let revealedCount = Math.min(REVEAL_BATCH, items.length);

    // jittered-grid layout: pure random placement clumps (birthday paradox)
    // and leaves empty holes — instead bucket the page into a grid with
    // one image per cell, jittered within the cell, so coverage is even
    // across the *entire* screen/page, edges and corners included.
    function layout() {
      // measure page height with the field collapsed first, else its own
      // previous height feeds back into scrollHeight and it can never grow
      bgField!.style.height = '0px';
      const h = Math.max(pageHeight(), window.innerHeight * 1.6);
      bgField!.style.height = `${h}px`;

      const vw = window.innerWidth || 1200;
      const isMobile = vw < 640;
      const visible = items.slice(0, revealedCount);
      const n = visible.length;
      const cols = Math.max(isMobile ? 3 : 2, Math.ceil(Math.sqrt((n * vw) / h)) || 5);
      const rows = Math.ceil(n / cols);
      const cellW = 100 / cols; // vw
      const cellH = h / rows;   // px

      // shuffle item order so the same image doesn't always land in the same cell
      const order = visible.map((_, i) => i);
      for (let i = order.length - 1; i > 0; i--) {
        const j = Math.floor(rand() * (i + 1));
        [order[i], order[j]] = [order[j], order[i]];
      }

      const cellWpx = (cellW / 100) * vw;
      // scale each image down well below its cell size — a proper scattered
      // look (small photos with visible space around them), not a solid
      // edge-to-edge wall of images
      const SCALE = isMobile ? 0.62 : 0.55;

      order.forEach((itemIdx, cellIdx) => {
        const el = visible[itemIdx];
        const col = cellIdx % cols;
        const row = Math.floor(cellIdx / cols);

        // size each image off its own cell, scaled well down, with a little
        // size jitter so the scatter doesn't look grid-uniform
        const w = cellWpx * SCALE * (0.8 + rand() * 0.3);
        const hgt = cellH * SCALE * (0.8 + rand() * 0.3);
        const wVw = (w / vw) * 100; // width expressed in vw, so we can clamp against the viewport edge
        const jitterX = (rand() - 0.5) * cellW * 0.5;
        const jitterY = (rand() - 0.5) * cellH * 0.5;

        // clamp so the WHOLE image (not just its anchor point) stays on-screen —
        // previously only the left edge was clamped, letting wide images spill
        // past the right edge and get clipped by the container's overflow:hidden
        const left = Math.max(0, Math.min(100 - wVw, col * cellW + cellW * 0.5 + jitterX - wVw / 2));
        const top = Math.max(0, Math.min(h - hgt, row * cellH + cellH * 0.5 + jitterY - hgt / 2));

        el.style.width = `${w}px`;
        el.style.height = `${hgt}px`;
        el.style.top = `${top}px`;
        el.style.left = `${left}vw`;
        el.style.transform = 'none';
        el.style.zIndex = String(1 + Math.floor(rand() * 3));
        el.classList.add('byob-revealed');
      });
    }

    function revealMore() {
      if (revealedCount >= items.length) return;
      revealedCount = Math.min(items.length, revealedCount + REVEAL_BATCH);
      layout();
    }

    // only reveal more scatter images while actually scrolling through
    // scatter mode — nearing the bottom of the (currently revealed) page
    // triggers the next batch, like a classic infinite-scroll feed
    function maybeRevealOnScroll() {
      if (field.dataset.mode !== 'scatter') return;
      if (revealedCount >= items.length) return;
      const scrollBottom = window.scrollY + window.innerHeight;
      const doc = document.documentElement;
      if (scrollBottom >= doc.scrollHeight - REVEAL_SCROLL_MARGIN_PX) {
        revealMore();
      }
    }

    layout();
    window.addEventListener('resize', layout);
    // page content (byob-field) can change page height when toggled — relayout after transition
    window.addEventListener('load', layout);
    setTimeout(layout, 700);
    window.addEventListener('scroll', maybeRevealOnScroll, { passive: true });
    // catch the case where the initial batch already fills less than one
    // screen (nothing to scroll yet) so more still trickles in on load
    setTimeout(maybeRevealOnScroll, 800);
  }
</script>

<style is:global>
  /* ─── full-screen scattered background ─── */
  /* this sits inside the page's max-w-4xl article wrapper (position:relative),
     which becomes its containing block since it's absolutely positioned —
     so width:100% capped at ~896px instead of the real viewport width on
     any screen wider than that. left:0 already lands at the viewport edge
     (abs-positioned children measure from the padding edge, ignoring the
     wrapper's own p-8 padding), so just force width to the true viewport. */
  .byob-bg-field {
    position: absolute;
    top: 0;
    left: 0;
    width: 100vw;
    min-height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .byob-bg-item {
    position: absolute;
    display: block;
    height: auto;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.8s ease;
    filter: contrast(1.02) saturate(0.95);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
  }

  .byob-bg-item.byob-revealed {
    opacity: 1;
  }

  /* by default this reads like any other art page's text block — plain
     body copy, no panel. Only in scatter mode (photos filling the screen
     behind it) does it need a solid dark, blurred panel for contrast —
     mix-blend-mode: difference used to do this unconditionally before but
     produced muddy, sometimes unreadable results depending on the
     underlying image's colors, and it was staying on even outside scatter */
  .byob-textblock {
    position: relative;
    z-index: 2;
  }

  body.byob-scatter .byob-textblock {
    isolation: isolate;
  }

  body.byob-scatter .byob-textblock::before {
    content: "";
    position: absolute;
    inset: -0.75rem -1rem;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-radius: 4px;
    z-index: -1;
  }

  body.byob-scatter .byob-textblock,
  body.byob-scatter .byob-textblock :is(p, dt, dd, span, strong) {
    color: #ffffff;
    mix-blend-mode: normal;
  }

  /* ─── toolbar ─── */
  .byob-toolbar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 2rem 0 0.75rem;
    position: relative;
    z-index: 20;
  }
  .byob-btn {
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: var(--text);
    color: var(--bg);
    border: none;
    padding: 0.4rem 0.85rem;
    cursor: pointer;
    transition: opacity 0.15s;
  }
  .byob-btn:hover { opacity: 0.7; }
  .byob-mode-hint {
    font-family: "DepartureMono", monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    text-transform: uppercase;
  }

  /* ─── field container defaults ─── */
  .byob-field {
    position: relative;
    z-index: 2;
    width: 100%;
    overflow: hidden;
  }

  /* ════════ SCATTER: images fill full viewport as BG ════════ */
  /* (position:fixed is applied by script; these set each image's size+place) */
  .byob-field[data-mode="scatter"] {
    /* container is fixed via inline style from script */
  }

  .byob-field[data-mode="scatter"] .byob-item {
    position: absolute;
    overflow: hidden;
  }

  .byob-field[data-mode="scatter"] .byob-extra-item {
    display: none;
  }

  /* arrange: only show the extra images once revealed via "load more" */
  .byob-field[data-mode="arrange"] .byob-extra-item {
    display: none;
  }
  .byob-field[data-mode="arrange"].byob-extras-revealed .byob-extra-item {
    display: block;
  }

  .byob-field[data-mode="scatter"] .byob-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.05) saturate(0.88);
  }

  /* viewport-scale scatter positions — no rotation */
  .byob-field[data-mode="scatter"] [data-i="0"] {
    top: 0;      left: -2vw;  width: 46vw; height: 62vh; z-index: 2;
  }
  .byob-field[data-mode="scatter"] [data-i="1"] {
    top: 10vh;   left: 54vw;  width: 34vw; height: 46vh; z-index: 1;
  }
  .byob-field[data-mode="scatter"] [data-i="2"] {
    top: 4vh;    left: 28vw;  width: 28vw; height: 38vh; z-index: 3;
  }
  .byob-field[data-mode="scatter"] [data-i="3"] {
    top: 56vh;   left: 76vw;  width: 26vw; height: 34vh; z-index: 2;
  }
  .byob-field[data-mode="scatter"] [data-i="4"] {
    top: 52vh;   left: 0;     width: 36vw; height: 50vh; z-index: 3;
  }
  .byob-field[data-mode="scatter"] [data-i="5"] {
    top: 48vh;   left: 36vw;  width: 30vw; height: 40vh; z-index: 4;
  }
  .byob-field[data-mode="scatter"] [data-i="6"] {
    top: 0;      left: 82vw;  width: 20vw; height: 30vh; z-index: 2;
  }
  .byob-field[data-mode="scatter"] [data-i="7"] {
    top: 66vh;   left: 6vw;   width: 28vw; height: 36vh; z-index: 3;
  }
  .byob-field[data-mode="scatter"] [data-i="8"] {
    top: 70vh;   left: 42vw;  width: 26vw; height: 32vh; z-index: 2;
  }
  .byob-field[data-mode="scatter"] [data-i="9"] {
    top: 58vh;   left: 68vw;  width: 30vw; height: 40vh; z-index: 1;
  }

  /* ════════ text blur + invert when scatter is active ════════ */

  /* ensure page text sits above the fixed BG images */
  body.byob-scatter .relative.z-10 {
    position: relative;
    z-index: 10; /* already z-10 from Tailwind, but reinforce */
  }

  /* invert the page h1 and back link too — and lift them above the fixed
     scatter field: elements with an explicit z-index (the field is z:1)
     paint AFTER auto-z-index siblings, so the title needs its own
     positioned stacking context with a higher z-index to stay visible */
  body.byob-scatter h1,
  body.byob-scatter .back-index-link {
    position: relative;
    z-index: 50;
    color: rgba(255, 255, 255, 0.9) !important;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
  }

  /* toolbar stays visible + readable */
  body.byob-scatter .byob-toolbar .byob-btn {
    background: rgba(255, 255, 255, 0.9);
    color: #000;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
  }
  body.byob-scatter .byob-toolbar .byob-mode-hint {
    color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
  }

  /* ════════ ARRANGE MODE: masonry — full images, no cropping ════════ */
  /* breaks out of the page's max-w-4xl article wrapper (left-aligned, not
     centered — so the usual `calc(-50vw + 50%)` full-bleed trick doesn't
     apply here) to span the full viewport width. The wrapper's left inset
     is Tailwind's p-8 (2rem), so cancel exactly that and go full 100vw. */
  .byob-field[data-mode="arrange"] {
    display: block;
    columns: 8; /* more, smaller columns — scaled-down tiles instead of large photos */
    column-gap: 8px;
    background: transparent;
    padding: 0;
    height: auto;
    width: 100vw;
    max-width: 100vw;
    margin-left: -2rem;
  }

  .byob-field[data-mode="arrange"] .byob-item {
    position: static;
    transform: none !important;
    overflow: hidden;
    break-inside: avoid;
    margin-bottom: 8px;
  }

  .byob-field[data-mode="arrange"] .byob-item img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    filter: contrast(1.06) saturate(0.88);
    transition: filter 0.2s;
  }
  .byob-field[data-mode="arrange"] .byob-item:hover img {
    filter: contrast(1.08) saturate(1);
  }

  @media (max-width: 1024px) {
    .byob-field[data-mode="arrange"] {
      columns: 6;
    }
  }

  @media (max-width: 640px) {
    .byob-field[data-mode="arrange"] {
      columns: 3;
    }
  }

  .byob-load-more {
    position: relative;
    z-index: 2;
    display: none;
    margin-top: 0.75rem;
  }

  .byob-caption {
    position: relative;
    z-index: 2;
    font-size: 10px !important;
    color: var(--text-dim);
    margin-top: 0.6rem;
    letter-spacing: 0.06em;
  }
</style>
