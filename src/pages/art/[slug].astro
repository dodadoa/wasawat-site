---
import Layout from "../../layouts/layout.astro"
import { artworkPages } from "../../data/artArchive.js"
import FromScratchLiveCoding from "../../subpages/art/FromScratchLiveCoding.astro"
import GimmeTheLight from "../../subpages/art/GimmeTheLight.astro"
import Unfest2025 from "../../subpages/art/Unfest2025.astro"
import BYOB from "../../subpages/art/BYOB.astro"
import EternalGainEternalPain from "../../subpages/art/EternalGainEternalPain.astro"
import HereNowAbsoluteElsewhere from "../../subpages/art/HereNowAbsoluteElsewhere.astro"
import SelfCensoredStepSequencer from "../../subpages/art/SelfCensoredStepSequencer.astro"
import AsIfYouWouldStillBeHere from "../../subpages/art/AsIfYouWouldStillBeHere.astro"
import OperationSeance from "../../subpages/art/OperationSeance.astro"
import DoTheNPCsHearTheSimulatedWind from "../../subpages/art/DoTheNPCsHearTheSimulatedWind.astro"
import NeonatusNeotokyo from "../../subpages/art/NeonatusNeotokyo.astro"
import TentacularTerritoria from "../../subpages/art/TentacularTerritoria.astro"
import IWillAlwaysThinkOfYouFondly from "../../subpages/art/IWillAlwaysThinkOfYouFondly.astro"
import TheImmortalsAreQuiteBusyTheseDays from "../../subpages/art/TheImmortalsAreQuiteBusyTheseDays.astro"
import TendernessKit from "../../subpages/art/TendernessKit.astro"
import WebsiteForStack from "../../subpages/art/WebsiteForStack.astro"
import WebsiteForTDBKK from "../../subpages/art/WebsiteForTDBKK.astro"
import PoeticGarden from "../../subpages/art/PoeticGarden.astro"
import TheAbstractionOfViolence from "../../subpages/art/TheAbstractionOfViolence.astro"
import Query from "../../subpages/art/Query.astro"

const components = {
  "do-the-npcs-hear-the-simulated-wind": DoTheNPCsHearTheSimulatedWind,
  "neonatus-neotokyo": NeonatusNeotokyo,
  "from-scratch-live-coding": FromScratchLiveCoding,
  "gimme-the-light": GimmeTheLight,
  unfest2025: Unfest2025,
  byob: BYOB,
  "eternal-gain-eternal-pain": EternalGainEternalPain,
  "here-now-absolute-elsewhere": HereNowAbsoluteElsewhere,
  "self-censored-step-sequencer": SelfCensoredStepSequencer,
  "as-if-you-would-still-be-here": AsIfYouWouldStillBeHere,
  "operation-seance": OperationSeance,
  "tentacular-territoria": TentacularTerritoria,
  "i-will-always-think-of-you-fondly": IWillAlwaysThinkOfYouFondly,
  "the-immortals-are-quite-busy-these-days": TheImmortalsAreQuiteBusyTheseDays,
  "tenderness-kit": TendernessKit,
  "website-for-stack": WebsiteForStack,
  "website-for-tdbkk": WebsiteForTDBKK,
  "poetic-garden": PoeticGarden,
  "the-abstraction-of-violence": TheAbstractionOfViolence,
  query: Query,
}

export function getStaticPaths() {
  return Object.keys(artworkPages).map((slug) => ({ params: { slug } }))
}

export const prerender = true

const { slug } = Astro.params

if (slug === "vina-v-para-cartography") {
  return Astro.redirect("/art/from-scratch-live-coding#vina-v")
}

const artwork = slug ? artworkPages[slug] : undefined
const Content = slug ? components[slug] : undefined

if (!artwork || !Content) {
  return Astro.redirect("/work")
}
---

<Layout title={artwork.title}>
  <div class="art-page relative z-10">
    <div class="art-chrome wipe">
      <a href="/work" class="btn back-index-link" aria-label="back to work">
        <span class="back-arrow" aria-hidden="true">←</span>
        <span class="back-label">Work</span>
      </a>
      <span class="data art-chrome-path">/art/{slug}</span>
    </div>
    <h1 class="art-detail-title wipe">{artwork.title}</h1>
    <div class="art-detail-body wipe">
      <Content />
    </div>
  </div>
</Layout>

<script>
  const zoomables = document.querySelectorAll<HTMLImageElement>(
    ".art-media-grid img, img.art-zoomable"
  )
  if (zoomables.length) {
    const overlay = document.createElement("div")
    overlay.className = "art-lightbox"
    overlay.setAttribute("role", "button")
    overlay.setAttribute("aria-label", "close")
    const full = document.createElement("img")
    overlay.appendChild(full)

    // hard cut on close: there is no fade to wait for
    const close = () => {
      overlay.classList.remove("is-open")
      overlay.remove()
      full.removeAttribute("src")
    }

    overlay.addEventListener("click", close)
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay.isConnected) close()
    })

    const open = (img: HTMLImageElement) => {
      full.src = img.currentSrc || img.src
      full.alt = img.alt || ""
      document.body.appendChild(overlay)
      requestAnimationFrame(() => overlay.classList.add("is-open"))
    }

    zoomables.forEach((img) => {
      // mark images clickable for the custom cursor (it expands over
      // a/button/[role=button]/[tabindex] targets) and for keyboards
      img.setAttribute("role", "button")
      img.setAttribute("tabindex", "0")
      img.setAttribute("aria-label", "enlarge")
      img.addEventListener("click", () => open(img))
      img.addEventListener("keydown", (e) => {
        if (e.key !== "Enter" && e.key !== " ") return
        e.preventDefault()
        open(img)
      })
    })
  }

  // inline "art-callout" links mid-paragraph pointing at a floated
  // .art-margin-note: the note can land anywhere in the flow (unlike the
  // row pattern's fixed-position arrow), so draw a curved connector in JS
  // from the underline to the note on hover/focus. It works both ways:
  // hovering the note lights up the phrase that points at it.
  const body = document.querySelector<HTMLElement>(".art-detail-body")
  const inlineCallouts = document.querySelectorAll<HTMLAnchorElement>(
    ".art-detail-body p .art-callout[href^='#']"
  )
  if (body && inlineCallouts.length) {
    const svgNs = "http://www.w3.org/2000/svg"
    const svg = document.createElementNS(svgNs, "svg")
    svg.setAttribute("class", "art-callout-connector")
    svg.setAttribute("aria-hidden", "true")
    const path = document.createElementNS(svgNs, "path")
    const head = document.createElementNS(svgNs, "circle")
    head.setAttribute("class", "art-callout-connector-head")
    head.setAttribute("r", "2")
    svg.append(path, head)
    body.appendChild(svg)

    let active: { link: HTMLAnchorElement; target: HTMLElement } | null = null

    const draw = () => {
      if (!active) return
      const bodyRect = body.getBoundingClientRect()
      const linkRect = active.link.getBoundingClientRect()
      const targetRect = active.target.getBoundingClientRect()
      svg.setAttribute("width", String(bodyRect.width))
      svg.setAttribute("height", String(bodyRect.height))
      const x1 = linkRect.right - bodyRect.left
      const y1 = linkRect.bottom - bodyRect.top
      const x2 = targetRect.left - bodyRect.left
      const y2 = targetRect.top - bodyRect.top + 14
      // right-angle connector: horizontal off the text, then a straight
      // vertical drop into the margin note — axis-aligned, no diagonal
      path.setAttribute("d", `M ${x1} ${y1} L ${x2} ${y1} L ${x2} ${y2}`)
      head.setAttribute("cx", String(x2))
      head.setAttribute("cy", String(y2))
    }

    const show = (link: HTMLAnchorElement, target: HTMLElement) => {
      hide()
      active = { link, target }
      link.classList.add("is-linked")
      target.classList.add("is-linked")
      draw()
      svg.classList.add("is-visible")
    }
    const hide = () => {
      active?.link.classList.remove("is-linked")
      active?.target.classList.remove("is-linked")
      active = null
      svg.classList.remove("is-visible")
    }

    inlineCallouts.forEach((link) => {
      const id = link.getAttribute("href")?.slice(1)
      const target = id ? document.getElementById(id) : null
      if (!target || !target.classList.contains("art-margin-note")) return
      link.addEventListener("mouseenter", () => show(link, target))
      link.addEventListener("mouseleave", hide)
      link.addEventListener("focus", () => show(link, target))
      link.addEventListener("blur", hide)
      // first callout pointing at a note owns the note's hover
      if (target.dataset.calloutBound) return
      target.dataset.calloutBound = "true"
      target.addEventListener("mouseenter", () => show(link, target))
      target.addEventListener("mouseleave", hide)
    })

    window.addEventListener("resize", draw)
    window.addEventListener("scroll", draw, { passive: true })
  }
</script>

<style>
  /* left-hung column with a wide empty margin of paper on the right */
  .art-page {
    padding: 2rem 2rem 6rem;
    max-width: max(56rem, 70vw);
  }

  .art-chrome {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-top: 1rem;
  }

  .art-chrome-path {
    font-size: 12px;
  }

  /* work titles run long, so they sit a step under the page-title scale */
  .art-detail-title {
    font-size: clamp(34px, 5.2vw, 76px);
    line-height: 1.08;
    max-width: 18em;
    margin: 2.6rem 0 2.4rem;
    filter: url(#ink-body);
  }

  .back-arrow {
    font-size: 1.1em;
    line-height: 1;
  }

  .back-arrow,
  .back-label {
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .art-detail-title {
      filter: url(#ink-small);
    }
  }

  @media (max-width: 640px) {
    .art-page {
      padding: 1.25rem 1rem 4rem;
    }
  }
</style>

<style is:global>
  .art-detail-body {
    position: relative;
    font-family: var(--f-body);
    font-size: 1rem;
    line-height: 1.45;
  }
  /* every subpage root carries mt-4; keep title and content close instead */
  .art-detail-body > .mt-4 {
    margin-top: 0;
  }
  .art-detail-body a {
    font-weight: normal;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .art-detail-body a:hover,
  .art-detail-body a.art-callout.is-linked {
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
  }
  .art-detail-body p,
  .art-detail-body li {
    line-height: 1.45;
    max-width: 64ch;
  }
  /* pages with long-form essay text opt into a wider measure */
  .art-detail-body .art-wide p,
  .art-detail-body .art-wide li {
    max-width: 76ch;
  }
  /* no bullets: unordered lists get a mono arrow, ordered ones a zero-padded
     counter in the pixel font, each row ruled off on top */
  .art-detail-body ul,
  .art-detail-body ol {
    list-style: none;
    padding: 0;
    max-width: 64ch;
  }
  .art-detail-body ol {
    counter-reset: step;
  }
  .art-detail-body ul > li,
  .art-detail-body ol > li {
    position: relative;
    margin: 0;
    padding: 0.55em 0 0.55em 3.2em;
    border-top: 1px solid var(--line);
  }
  .art-detail-body ul > li::before,
  .art-detail-body ol > li::before {
    position: absolute;
    left: 0;
    top: 0.75em;
    font-family: var(--f-pixel);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--soft);
    line-height: 1.4;
  }
  .art-detail-body ul > li::before {
    content: "→";
  }
  .art-detail-body ol > li {
    counter-increment: step;
  }
  .art-detail-body ol > li::before {
    content: counter(step, decimal-leading-zero);
  }
  /* section headers — never all-caps; keep the markup's own Title Case */
  .art-detail-body h2,
  .art-detail-body .text-xl {
    font-family: var(--f-display);
    text-transform: none;
    font-size: calc(32px * var(--ui-scale, 1));
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.16;
    margin-top: 3rem;
    margin-bottom: 1rem;
    filter: url(#ink-small);
  }
  /* small pixel-font section kickers ("How to use", "References") */
  .art-detail-body h2.art-kicker {
    font-family: var(--f-pixel);
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    border-top: 3px solid var(--ink);
    padding-top: 0.8rem;
    margin-top: 3.5rem;
    filter: none;
    max-width: 64ch;
  }
  /* meta: captions, credits footer, inline labels — the data voice */
  .art-detail-body figcaption,
  .art-detail-body p.text-sm,
  .art-detail-body div.text-sm,
  .art-detail-body ul.text-sm,
  .art-detail-body ol.text-sm,
  .art-detail-body .text-sm p,
  .art-detail-body .text-sm li {
    font-family: var(--f-data);
    font-size: 13px;
    line-height: 1.6;
    color: var(--soft);
  }
  /* the one tagline under the title — opted in per page, never inferred from
     .opacity-80, which also tags small labels and footnotes */
  .art-detail-body .art-lead {
    font-family: var(--f-body);
    font-size: clamp(22px, 2.2vw, 28px);
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 2.2rem;
    max-width: 30em;
  }
  .art-detail-body code {
    font-size: 0.85em;
  }
  .art-detail-body video {
    width: 100%;
    max-width: min(720px, 100%);
    height: auto;
    display: block;
    border: 1px solid var(--line);
  }
  .art-detail-body iframe {
    border: 1px solid var(--line);
  }
  /* academic footnotes (P.S. notes) */
  .art-footnotes {
    position: relative;
    margin-top: 3rem;
    padding-top: 0.9rem;
  }
  .art-footnotes::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 72px;
    border-top: 1px solid var(--ink);
  }
  .art-footnotes p {
    font-family: var(--f-data);
    font-size: 13px;
    line-height: 1.6;
    color: var(--soft);
    padding-left: 1.6em;
    text-indent: -1.6em;
    margin: 0 0 0.4rem;
    max-width: 62ch;
  }
  .art-footnotes sup {
    font-size: 0.75em;
    margin-right: 0.45em;
  }
  /* media section: all images/videos gathered in a grid below the text;
     cells butt up against each other and share their hairlines */
  .art-detail-body .art-media-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 14px;
    align-items: start;
    margin-top: 3.5rem;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .art-detail-body .art-media-grid figure {
    margin: 0;
  }
  .art-detail-body .art-media-grid img,
  .art-detail-body .art-media-grid video {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
    border: 1px solid var(--line);
    background: #fff;
  }
  .art-detail-body .art-media-grid .art-media-full {
    grid-column: 1 / -1;
  }
  /* two images side by side share one height: the taller sets the row and
     the other fills it, cropped (the lightbox still shows the whole image).
     Captioned figures borrow the grid's rows so the images line up even
     when the captions wrap to different lengths. */
  .art-detail-body .art-media-grid > img:not(.art-media-full) {
    align-self: stretch;
    object-fit: cover;
  }
  .art-detail-body .art-media-grid > figure:not(.art-media-full) {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
    row-gap: 0;
    align-self: stretch;
  }
  .art-detail-body .art-media-grid > figure:not(.art-media-full) > img {
    align-self: stretch;
    object-fit: cover;
  }
  /* click-to-enlarge: hint on the thumbnail, overlay to view */
  .art-detail-body .art-media-grid img,
  .art-detail-body .art-zoomable {
    cursor: zoom-in;
  }
  .art-detail-body .art-media-grid img:hover,
  .art-detail-body .art-zoomable:hover {
    border-color: var(--ink);
    outline: 2px solid var(--ink);
    outline-offset: -3px;
  }
  /* annotation callout: a boxed phrase in the text pointing at a small
     image to its right (clickable to enlarge) */
  .art-detail-body .art-callout-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    /* reserve the margin-note column; the figure hangs there absolutely so
       the row is only as tall as the phrase and content follows right away */
    padding-right: 166px;
    margin-bottom: 0.7rem;
  }
  /* let the note sit past the text column, at the page's right margin */
  @media (min-width: 64rem) {
    .art-detail-body .art-callout-row {
      margin-right: -4rem;
    }
  }
  .art-detail-body .art-callout-row .art-lead {
    margin-bottom: 0;
    flex: 0 0 auto;
  }
  .art-detail-body .art-callout {
    display: inline-block;
    text-decoration: underline;
    text-decoration-style: dashed;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--soft);
    text-underline-offset: 4px;
  }
  /* connector stretches so the figure lands flush right, footnote-style;
     hidden until the reader hovers the row — a hard cut, no fade */
  .art-detail-body .art-callout-arrow {
    flex: 1 1 auto;
    min-width: 2.5rem;
    height: 0;
    border-top: 1px solid var(--red);
    position: relative;
    visibility: hidden;
  }
  .art-detail-body .art-callout-row:hover .art-callout-arrow {
    visibility: visible;
  }
  .art-detail-body .art-callout-arrow::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--red);
    border-right: 1px solid var(--red);
    transform: translateY(-58%) rotate(45deg);
  }
  .art-detail-body .art-callout-figure {
    position: absolute;
    right: 0;
    top: 0;
    width: 150px;
    margin: 0;
  }
  .art-detail-body .art-callout-figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .art-detail-body .art-callout-figure figcaption {
    font-size: 11px;
    line-height: 1.5;
  }
  /* tall margin note (interactive diagrams): floats right so text wraps
     beside it and grids/blocks below clear it on their own. Side-notes are
     framed with a dashed rule. */
  .art-detail-body .art-margin-note {
    float: right;
    width: 240px;
    margin: 0 0 1rem 4rem;
    outline: 1px dashed var(--soft);
    outline-offset: 8px;
  }
  /* hovering (or focusing) an inline callout that links to a margin note
     highlights the note it refers to: the rule goes to a fine red line */
  .art-detail-body:has(.art-callout:hover) .art-margin-note,
  .art-detail-body:has(.art-callout:focus-visible) .art-margin-note,
  .art-detail-body .art-margin-note.is-linked {
    outline: 1px solid var(--red);
  }
  a.art-callout {
    cursor: pointer;
  }
  /* right-angle connector from an inline callout to its margin note, drawn
     in JS since the note can land anywhere in the flow; shown on hover/focus */
  .art-detail-body .art-callout-connector {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    visibility: hidden;
    z-index: 1;
    shape-rendering: crispEdges;
  }
  .art-detail-body .art-callout-connector.is-visible {
    visibility: visible;
  }
  .art-detail-body .art-callout-connector path {
    fill: none;
    stroke: var(--red);
    stroke-width: 1;
  }
  .art-detail-body .art-callout-connector .art-callout-connector-head {
    fill: var(--red);
  }
  @media (max-width: 640px) {
    .art-detail-body .art-callout-connector {
      display: none;
    }
  }
  @media (min-width: 64rem) {
    .art-detail-body .art-margin-note {
      margin-left: 6rem;
      margin-right: -12rem;
    }
  }
  @media (min-width: 80rem) {
    .art-detail-body .art-margin-note {
      margin-right: -16rem;
    }
  }
  @media (max-width: 640px) {
    .art-detail-body .art-margin-note {
      float: none;
      width: 100%;
      margin: 1rem 0;
    }
  }
  @media (max-width: 640px) {
    .art-detail-body .art-callout-row {
      flex-wrap: wrap;
      padding-right: 0;
      margin-bottom: 1.2rem;
    }
    .art-detail-body .art-callout-arrow {
      display: none;
    }
    .art-detail-body .art-callout-figure {
      position: static;
      margin-top: 0.7rem;
    }
  }
  /* lightbox: a modal over the page — the content stays visible behind, blurred */
  .art-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5vmin;
    background: color-mix(in srgb, var(--bg) 45%, transparent);
    -webkit-backdrop-filter: blur(10px) saturate(0.25);
    backdrop-filter: blur(10px) saturate(0.25);
    cursor: zoom-out;
    clip-path: inset(0 0 100% 0);
  }
  /* a light ordered dither over the blurred page, under the image */
  .art-lightbox::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--dither-12);
    opacity: 0.22;
    pointer-events: none;
  }
  .art-lightbox.is-open {
    clip-path: inset(0 0 0 0);
    transition: clip-path 600ms var(--wipe-ease);
  }
  .art-lightbox img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
    position: relative;
    background: #fff;
  }
  @media (max-width: 640px) {
    .art-detail-body .art-media-grid {
      grid-template-columns: 1fr;
    }
  }
  .art-detail-body .art-diagram img {
    width: 100%;
    max-width: min(420px, 80%);
    height: auto;
    display: block;
  }
</style>
