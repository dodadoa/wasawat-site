---
import Layout from "../../layouts/layout.astro"
import { artworkPages } from "../../data/artArchive.js"
import FromScratchLiveCoding from "../../subpages/art/FromScratchLiveCoding.astro"
import GimmeTheLight from "../../subpages/art/GimmeTheLight.astro"
import Unfest2025 from "../../subpages/art/Unfest2025.astro"
import BYOB from "../../subpages/art/BYOB.astro"
import EternalGainEternalPain from "../../subpages/art/EternalGainEternalPain.astro"
import HereNowAbsoluteElsewhere from "../../subpages/art/HereNowAbsoluteElsewhere.astro"
import SelfCensoredStepSequencer from "../../subpages/art/SelfCensoredStepSequencer.astro"
import AsIfYouWouldStillBeHere from "../../subpages/art/AsIfYouWouldStillBeHere.astro"
import OperationSeance from "../../subpages/art/OperationSeance.astro"
import DoTheNPCsHearTheSimulatedWind from "../../subpages/art/DoTheNPCsHearTheSimulatedWind.astro"
import NeonatusNeotokyo from "../../subpages/art/NeonatusNeotokyo.astro"
import TentacularTerritoria from "../../subpages/art/TentacularTerritoria.astro"
import IWillAlwaysThinkOfYouFondly from "../../subpages/art/IWillAlwaysThinkOfYouFondly.astro"
import TheImmortalsAreQuiteBusyTheseDays from "../../subpages/art/TheImmortalsAreQuiteBusyTheseDays.astro"
import TendernessKit from "../../subpages/art/TendernessKit.astro"
import WebsiteForStack from "../../subpages/art/WebsiteForStack.astro"
import WebsiteForTDBKK from "../../subpages/art/WebsiteForTDBKK.astro"
import PoeticGarden from "../../subpages/art/PoeticGarden.astro"

const components = {
  "do-the-npcs-hear-the-simulated-wind": DoTheNPCsHearTheSimulatedWind,
  "neonatus-neotokyo": NeonatusNeotokyo,
  "from-scratch-live-coding": FromScratchLiveCoding,
  "gimme-the-light": GimmeTheLight,
  unfest2025: Unfest2025,
  byob: BYOB,
  "eternal-gain-eternal-pain": EternalGainEternalPain,
  "here-now-absolute-elsewhere": HereNowAbsoluteElsewhere,
  "self-censored-step-sequencer": SelfCensoredStepSequencer,
  "as-if-you-would-still-be-here": AsIfYouWouldStillBeHere,
  "operation-seance": OperationSeance,
  "tentacular-territoria": TentacularTerritoria,
  "i-will-always-think-of-you-fondly": IWillAlwaysThinkOfYouFondly,
  "the-immortals-are-quite-busy-these-days": TheImmortalsAreQuiteBusyTheseDays,
  "tenderness-kit": TendernessKit,
  "website-for-stack": WebsiteForStack,
  "website-for-tdbkk": WebsiteForTDBKK,
  "poetic-garden": PoeticGarden,
}

export function getStaticPaths() {
  return Object.keys(artworkPages).map((slug) => ({ params: { slug } }))
}

export const prerender = true

const { slug } = Astro.params

if (slug === "vina-v-para-cartography") {
  return Astro.redirect("/art/from-scratch-live-coding#vina-v")
}

const artwork = slug ? artworkPages[slug] : undefined
const Content = slug ? components[slug] : undefined

if (!artwork || !Content) {
  return Astro.redirect("/work")
}
---

<Layout title={artwork.title}>
  <div class="relative z-10 p-8 pb-20 max-w-4xl">
    <div class="back-index-wrap">
      <a href="/work" class="back-index-link">
        <span class="back-arrow" aria-hidden="true">←</span>
        <span class="back-label">Work</span>
      </a>
    </div>
    <h1 class="art-detail-title mt-6 mb-2">{artwork.title}</h1>
    <div class="art-detail-body">
      <Content />
    </div>
  </div>
</Layout>

<script>
  const zoomables = document.querySelectorAll<HTMLImageElement>(
    ".art-media-grid img, img.art-zoomable"
  )
  if (zoomables.length) {
    const overlay = document.createElement("div")
    overlay.className = "art-lightbox"
    overlay.setAttribute("role", "button")
    overlay.setAttribute("aria-label", "close")
    const full = document.createElement("img")
    overlay.appendChild(full)

    const close = () => {
      overlay.classList.remove("is-open")
      overlay.addEventListener(
        "transitionend",
        () => {
          overlay.remove()
          full.removeAttribute("src")
        },
        { once: true }
      )
    }

    overlay.addEventListener("click", close)
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && overlay.isConnected) close()
    })

    const open = (img: HTMLImageElement) => {
      full.src = img.currentSrc || img.src
      full.alt = img.alt || ""
      document.body.appendChild(overlay)
      requestAnimationFrame(() => overlay.classList.add("is-open"))
    }

    zoomables.forEach((img) => {
      // mark images clickable for the custom cursor (it expands over
      // a/button/[role=button]/[tabindex] targets) and for keyboards
      img.setAttribute("role", "button")
      img.setAttribute("tabindex", "0")
      img.setAttribute("aria-label", "enlarge")
      img.addEventListener("click", () => open(img))
      img.addEventListener("keydown", (e) => {
        if (e.key !== "Enter" && e.key !== " ") return
        e.preventDefault()
        open(img)
      })
    })
  }
</script>

<style>
  /* title sized like the news page (.news-title: 22px, normal weight) */
  .art-detail-title {
    font-size: calc(26px * var(--ui-scale, 1));
    font-weight: normal;
    letter-spacing: 0.01em;
    line-height: 1.25;
    color: var(--text);
  }

  /* neumorphic (soft-UI) pill: raised at rest, pressed-in on hover/active */
  .back-index-wrap {
    display: inline-flex;
    opacity: 0;
    transform: translateX(-10px);
    animation: back-link-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
    border: none;
    border-radius: 14px;
    background: linear-gradient(145deg, #f6f6f6, #ececec);
    box-shadow:
      5px 5px 10px rgba(190, 190, 190, 0.55),
      -5px -5px 10px rgba(255, 255, 255, 0.95);
    transition: box-shadow 0.18s ease, background 0.18s ease;
  }

  .back-index-wrap:has(.back-index-link:hover) {
    background: linear-gradient(145deg, #ececec, #f6f6f6);
    box-shadow:
      inset 4px 4px 8px rgba(190, 190, 190, 0.55),
      inset -4px -4px 8px rgba(255, 255, 255, 0.95);
  }

  .back-index-wrap:has(.back-index-link:active) {
    box-shadow:
      inset 6px 6px 12px rgba(180, 180, 180, 0.6),
      inset -6px -6px 12px rgba(255, 255, 255, 0.9);
  }

  .back-index-link {
    display: flex;
    align-items: center;
    gap: 0.5em;
    width: 100%;
    color: var(--text-muted);
    font-family: "DepartureMono", monospace;
    font-size: calc(11px * var(--ui-scale, 1));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.5em 0.8em;
    border: none;
    transition: color 0.15s ease;
  }

  .back-index-link:hover {
    color: var(--text);
  }

  .back-index-link:hover .back-arrow {
    transform: translateX(-3px);
  }

  .back-arrow {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    font-size: 1.1em;
    line-height: 1;
  }

  .back-arrow,
  .back-label {
    pointer-events: none;
  }

  @keyframes back-link-in {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<style is:global>
  .art-detail-body {
    font-family: "DepartureMono", monospace;
    font-size: calc(12px * var(--ui-scale, 1));
    line-height: 1.5;
  }
  /* every subpage root carries mt-4; keep title and content close instead */
  .art-detail-body > .mt-4 {
    margin-top: 0;
  }
  .art-detail-body a {
    font-weight: normal;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* keep the measure readable: mono at 13px runs wide across max-w-3xl */
  .art-detail-body p,
  .art-detail-body li {
    line-height: 1.5;
    max-width: 72ch;
  }
  /* pages with long-form essay text opt into a wider measure */
  .art-detail-body .art-wide p,
  .art-detail-body .art-wide li {
    max-width: 100ch;
  }
  /* section headers - never all-caps; keep the markup's own Title Case */
  .art-detail-body h2,
  .art-detail-body .text-xl {
    font-family: "403Mesapholic", monospace;
    text-transform: none;
    font-size: calc(20px * var(--ui-scale, 1));
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.25;
    margin-top: 2.4rem;
    margin-bottom: 0.7rem;
  }
  /* meta: captions, credits footer, inline labels ("References", "Line-up") */
  .art-detail-body figcaption,
  .art-detail-body p.text-sm,
  .art-detail-body div.text-sm,
  .art-detail-body ul.text-sm,
  .art-detail-body ol.text-sm {
    font-size: calc(11px * var(--ui-scale, 1));
    line-height: 1.4;
  }
  /* the one tagline under the title - opted in per page, never inferred from
     .opacity-80, which also tags small labels and footnotes */
  .art-detail-body .art-lead {
    font-size: calc(14px * var(--ui-scale, 1));
    line-height: 1.35;
    color: var(--text-muted);
    margin-bottom: 1.7rem;
    max-width: 62ch;
  }
  .art-detail-body code {
    font-size: calc(12px * var(--ui-scale, 1));
  }
  .art-detail-body video {
    width: 100%;
    max-width: min(720px, 100%);
    height: auto;
    display: block;
  }
  /* academic footnotes (P.S. notes) */
  .art-footnotes {
    position: relative;
    margin-top: 2.4rem;
    padding-top: 0.7rem;
  }
  .art-footnotes::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 72px;
    border-top: 1px solid var(--text-dim);
  }
  .art-footnotes p {
    font-size: calc(11px * var(--ui-scale, 1));
    line-height: 1.45;
    color: var(--text-dim);
    padding-left: 1.4em;
    text-indent: -1.4em;
    margin: 0 0 0.4rem;
    max-width: 62ch;
  }
  .art-footnotes sup {
    font-size: 0.75em;
    margin-right: 0.45em;
  }
  /* media section: all images/videos gathered in a grid below the text */
  .art-detail-body .art-media-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    align-items: start;
    margin-top: 2.5rem;
  }
  .art-detail-body .art-media-grid figure {
    margin: 0;
  }
  .art-detail-body .art-media-grid img,
  .art-detail-body .art-media-grid video {
    width: 100%;
    max-width: 100%;
    height: auto;
    display: block;
  }
  .art-detail-body .art-media-grid .art-media-full {
    grid-column: 1 / -1;
  }
  /* click-to-enlarge: hint on the thumbnail, overlay to view */
  .art-detail-body .art-media-grid img,
  .art-detail-body .art-zoomable {
    cursor: zoom-in;
  }
  /* annotation callout: a boxed phrase in the text pointing at a small
     image to its right (clickable to enlarge) */
  .art-detail-body .art-callout-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1rem;
    /* reserve the margin-note column; the figure hangs there absolutely so
       the row is only as tall as the phrase and content follows right away */
    padding-right: 166px;
    margin-bottom: 0.7rem;
  }
  /* let the note sit past the text column, at the page's right margin */
  @media (min-width: 64rem) {
    .art-detail-body .art-callout-row {
      margin-right: -4rem;
    }
  }
  .art-detail-body .art-callout-row .art-lead {
    margin-bottom: 0;
    flex: 0 0 auto;
    font-size: calc(20px * var(--ui-scale, 1));
  }
  .art-detail-body .art-callout {
    display: inline-block;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-decoration-color: var(--text-muted);
    text-underline-offset: 4px;
  }
  /* connector stretches so the figure lands flush right, footnote-style;
     hidden until the reader hovers the row */
  .art-detail-body .art-callout-arrow {
    flex: 1 1 auto;
    min-width: 2.5rem;
    height: 0;
    border-top: 1px solid var(--text-muted);
    position: relative;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .art-detail-body .art-callout-row:hover .art-callout-arrow {
    opacity: 1;
  }
  .art-detail-body .art-callout-arrow::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--text-muted);
    border-right: 1px solid var(--text-muted);
    transform: translateY(-58%) rotate(45deg);
  }
  .art-detail-body .art-callout-figure {
    position: absolute;
    right: 0;
    top: 0;
    width: 150px;
    margin: 0;
  }
  .art-detail-body .art-callout-figure img {
    width: 100%;
    height: auto;
    display: block;
  }
  .art-detail-body .art-callout-figure figcaption {
    font-size: calc(9px * var(--ui-scale, 1));
    line-height: 1.4;
  }
  /* tall margin note (interactive diagrams): floats right so text wraps
     beside it and grids/blocks below clear it on their own */
  .art-detail-body .art-margin-note {
    float: right;
    width: 240px;
    margin: 0 0 1rem 2rem;
  }
  @media (min-width: 64rem) {
    .art-detail-body .art-margin-note {
      margin-right: -4rem;
    }
  }
  @media (max-width: 640px) {
    .art-detail-body .art-margin-note {
      float: none;
      width: 100%;
      margin: 1rem 0;
    }
  }
  @media (max-width: 640px) {
    .art-detail-body .art-callout-row {
      flex-wrap: wrap;
      padding-right: 0;
      margin-bottom: 1.2rem;
    }
    .art-detail-body .art-callout-arrow {
      display: none;
    }
    .art-detail-body .art-callout-figure {
      position: static;
      margin-top: 0.7rem;
    }
  }
  .art-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4vmin;
    background: rgba(10, 10, 10, 0.88);
    cursor: zoom-out;
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .art-lightbox.is-open {
    opacity: 1;
  }
  .art-lightbox img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }
  @media (max-width: 640px) {
    .art-detail-body .art-media-grid {
      grid-template-columns: 1fr;
    }
  }
  .art-detail-body .art-diagram img {
    width: 100%;
    max-width: min(420px, 80%);
    height: auto;
    display: block;
  }
</style>
