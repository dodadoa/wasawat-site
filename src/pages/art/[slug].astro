---
import Layout from "../../layouts/layout.astro"
import { artworkPages } from "../../data/artArchive.js"
import FromScratchLiveCoding from "../../subpages/art/FromScratchLiveCoding.astro"
import GimmeTheLight from "../../subpages/art/GimmeTheLight.astro"
import Unfest2025 from "../../subpages/art/Unfest2025.astro"
import BYOB from "../../subpages/art/BYOB.astro"
import EternalGainEternalPain from "../../subpages/art/EternalGainEternalPain.astro"
import HereNowAbsoluteElsewhere from "../../subpages/art/HereNowAbsoluteElsewhere.astro"
import SelfCensoredStepSequencer from "../../subpages/art/SelfCensoredStepSequencer.astro"
import AsIfYouWouldStillBeHere from "../../subpages/art/AsIfYouWouldStillBeHere.astro"
import OperationSeance from "../../subpages/art/OperationSeance.astro"
import DoTheNPCsHearTheSimulatedWind from "../../subpages/art/DoTheNPCsHearTheSimulatedWind.astro"
import NeonatusNeotokyo from "../../subpages/art/NeonatusNeotokyo.astro"
import TentacularTerritoria from "../../subpages/art/TentacularTerritoria.astro"
import IWillAlwaysThinkOfYouFondly from "../../subpages/art/IWillAlwaysThinkOfYouFondly.astro"
import TheImmortalsAreQuiteBusyTheseDays from "../../subpages/art/TheImmortalsAreQuiteBusyTheseDays.astro"
import TendernessKit from "../../subpages/art/TendernessKit.astro"
import WebsiteForStack from "../../subpages/art/WebsiteForStack.astro"
import WebsiteForTDBKK from "../../subpages/art/WebsiteForTDBKK.astro"
import PoeticGarden from "../../subpages/art/PoeticGarden.astro"

const components = {
  "do-the-npcs-hear-the-simulated-wind": DoTheNPCsHearTheSimulatedWind,
  "neonatus-neotokyo": NeonatusNeotokyo,
  "from-scratch-live-coding": FromScratchLiveCoding,
  "gimme-the-light": GimmeTheLight,
  unfest2025: Unfest2025,
  byob: BYOB,
  "eternal-gain-eternal-pain": EternalGainEternalPain,
  "here-now-absolute-elsewhere": HereNowAbsoluteElsewhere,
  "self-censored-step-sequencer": SelfCensoredStepSequencer,
  "as-if-you-would-still-be-here": AsIfYouWouldStillBeHere,
  "operation-seance": OperationSeance,
  "tentacular-territoria": TentacularTerritoria,
  "i-will-always-think-of-you-fondly": IWillAlwaysThinkOfYouFondly,
  "the-immortals-are-quite-busy-these-days": TheImmortalsAreQuiteBusyTheseDays,
  "tenderness-kit": TendernessKit,
  "website-for-stack": WebsiteForStack,
  "website-for-tdbkk": WebsiteForTDBKK,
  "poetic-garden": PoeticGarden,
}

export function getStaticPaths() {
  return Object.keys(artworkPages).map((slug) => ({ params: { slug } }))
}

export const prerender = true

const { slug } = Astro.params

if (slug === "vina-v-para-cartography") {
  return Astro.redirect("/art/from-scratch-live-coding#vina-v")
}

const artwork = slug ? artworkPages[slug] : undefined
const Content = slug ? components[slug] : undefined

if (!artwork || !Content) {
  return Astro.redirect("/work")
}
---

<Layout title={artwork.title}>
  <div class="relative z-10 p-8 pb-20 max-w-4xl">
    <div class="back-index-wrap">
      <a href="/work" class="back-index-link">
        <span class="back-arrow" aria-hidden="true">←</span>
        <span class="back-label">Work</span>
      </a>
    </div>
    <h1 class="font-bold text-xl lg:text-2xl mt-6 mb-3" style="color: var(--text);">{artwork.title}</h1>
    <div class="art-detail-body">
      <Content />
    </div>
  </div>
</Layout>

<style>
  .back-index-wrap {
    display: inline-flex;
    opacity: 0;
    transform: translateX(-10px);
    animation: back-link-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) 0.1s forwards;
    border: 1px solid var(--border-subtle);
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .back-index-wrap:has(.back-index-link:hover) {
    border-color: var(--border);
    background: var(--bg-elevated);
  }

  .back-index-link {
    display: flex;
    align-items: center;
    gap: 0.5em;
    width: 100%;
    color: var(--text-muted);
    font-family: "DepartureMono", monospace;
    font-size: calc(11px * var(--ui-scale, 1));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.5em 0.8em;
    border: none;
    transition: color 0.15s ease;
  }

  .back-index-link:hover {
    color: var(--text);
  }

  .back-index-link:hover .back-arrow {
    transform: translateX(-3px);
  }

  .back-arrow {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    font-size: 1.1em;
    line-height: 1;
  }

  .back-arrow,
  .back-label {
    pointer-events: none;
  }

  @keyframes back-link-in {
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }
</style>

<style is:global>
  .art-detail-body {
    font-family: "DepartureMono", monospace;
    font-size: calc(12px * var(--ui-scale, 1));
    line-height: 1.5;
  }
  .art-detail-body a {
    font-weight: normal;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .art-detail-body p,
  .art-detail-body li {
    line-height: 1.5;
  }
  /* topic / credits / tagline — subheader */
  .art-detail-body p.text-sm.opacity-80 {
    font-size: calc(14px * var(--ui-scale, 1));
    line-height: 1.45;
  }
  /* section headers */
  .art-detail-body h2,
  .art-detail-body .text-xl {
    font-family: "403Mesapholic", monospace;
    font-size: calc(20px * var(--ui-scale, 1));
    font-weight: 400;
    margin-top: 1.6rem;
    margin-bottom: 0.5rem;
  }
  /* meta: captions, credits footer, references label */
  .art-detail-body figcaption,
  .art-detail-body p.text-sm.opacity-70,
  .art-detail-body p.text-sm:not(.opacity-80),
  .art-detail-body div.text-sm {
    font-size: calc(11px * var(--ui-scale, 1));
    line-height: 1.45;
  }
  .art-detail-body ul.text-sm {
    font-size: calc(12px * var(--ui-scale, 1));
  }
  .art-detail-body code {
    font-size: calc(11px * var(--ui-scale, 1));
  }
  .art-detail-body video {
    width: 100%;
    max-width: min(480px, 85%);
    height: auto;
    display: block;
  }
  /* academic footnotes (P.S. notes) */
  .art-footnotes {
    position: relative;
    margin-top: 2.2rem;
    padding-top: 0.7rem;
  }
  .art-footnotes::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 72px;
    border-top: 1px solid var(--text-dim);
  }
  .art-footnotes p {
    font-size: calc(10.5px * var(--ui-scale, 1));
    line-height: 1.55;
    color: var(--text-dim);
    padding-left: 1.4em;
    text-indent: -1.4em;
    margin: 0 0 0.35rem;
    max-width: 60ch;
  }
  .art-footnotes sup {
    font-size: 0.75em;
    margin-right: 0.45em;
  }
  .art-detail-body .art-diagram img {
    width: 100%;
    max-width: min(420px, 80%);
    height: auto;
    display: block;
  }
</style>
