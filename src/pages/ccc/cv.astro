---
// Hidden page — not linked from navigation, excluded from search engines.
import "@fontsource/jetbrains-mono/400.css"
import "@fontsource/jetbrains-mono/700.css"
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Cornea Cochlear Club — CV</title>
  </head>
  <body>
    <div class="toolbar">
      <a href="/about" class="breadcrumb-link">~/giang /ccc /cv</a>
      <button onclick="window.print()" class="pdf-btn">↓ Download PDF</button>
    </div>
    <main class="page">

      <header>
        <h1>Cornea Cochlear Club</h1>
        <p class="tagline">BKK-based. LiveCoding. AudioVisual.</p>
        <p class="contact">
          Bangkok, Thailand ·
          <a href="https://www.instagram.com/corneacochlearclub/">@corneacochlearclub</a>
        </p>
      </header>

      <!-- ── Profile ── -->
      <section>
        <h2>profile:</h2>
        <p class="profile">
          Cornea Cochlear Club is a Bangkok-based collective working at the intersection of live
          coding and audiovisual performance — organizing showcases, running club nights, and
          bringing touring live-coders and AV artists into the local scene. The name splits the two
          senses it works through: eye and ear, screen and speaker, code rendered live as both image
          and sound.
        </p>
      </section>

      <!-- ── Events Organized ── -->
      <section>
        <h2>events organized:</h2>

        <div class="row">
          <span class="row-year">2026</span>
          <div class="row-body">
            <span class="row-title">Synecdoche, Synesthesia</span> — <em>Live coding &amp; AV showcase</em>, Bangkok Kunsthalle, 4 April, w/ Goethe-Institut Thailand
          </div>
        </div>
        <div class="row">
          <span class="row-year">2026</span>
          <div class="row-body">
            <span class="row-title">FLUX</span>
          </div>
        </div>
        <div class="row">
          <span class="row-year">2026</span>
          <div class="row-body">
            <span class="row-title">Overflow</span> — <em>Live coding &amp; AV performance night</em>, Goethe-Institut Thailand, supported by Pro Helvetia &amp; Arai Eek CNX, in collaboration with SYNAP Home Lab &amp; KOLAB.BKK
          </div>
        </div>
        <div class="row">
          <span class="row-year">2025</span>
          <div class="row-body">
            <span class="row-title">GL[𝐼𝑇𝐶𝐻𝐼𝑁𝐺] MACH\NE</span> — <em>Live coding &amp; AV performance</em>, October
          </div>
        </div>
        <div class="row">
          <span class="row-year">2025</span>
          <div class="row-body">
            <span class="row-title">UNFEST'25</span> — <em>Live coding party</em>, Unformat Studio, 10 March
          </div>
        </div>
        <div class="row">
          <span class="row-year">2025</span>
          <div class="row-body">
            <span class="row-title">HEAR/HEX/HALT</span> — <em>Live coding &amp; AV performance</em>, Goethe-Institut Thailand, 6 January
          </div>
        </div>
        <div class="row">
          <span class="row-year">2025</span>
          <div class="row-body">
            <span class="row-title">evals</span> — <em>Live coding showcase</em>, Bangkok Kunsthalle
          </div>
        </div>
        <div class="row">
          <span class="row-year">2024</span>
          <div class="row-body">
            <span class="row-title">CYBERNAUT PARTY</span> — <em>Live coding &amp; AV party</em>, Unformat Studio, 7 June, w/ artists from NYC, Ho Chi Minh City &amp; Bangkok
          </div>
        </div>
        <div class="row">
          <span class="row-year">2024</span>
          <div class="row-body">
            <span class="row-title">Non-Zero-Sum Game</span> — <em>Electronic music night &amp; AV performance</em>, MAL.BKK
          </div>
        </div>
      </section>

      <!-- ── Featured Artists ── -->
      <section>
        <h2>featured artists (selected):</h2>
        <div class="artist-grid">
          <div class="artist"><span class="artist-name">Wasawat Somno</span> — <span class="artist-detail">@giang_ws, co-organizer &amp; curator</span></div>
          <div class="artist"><span class="artist-name">elekhlekha</span> — <span class="artist-detail">Bangkok/Brooklyn, live coding &amp; AV duo</span></div>
          <div class="artist"><span class="artist-name">Renick Bell</span> — <span class="artist-detail">US, live coding pioneer, creator of Conductive/Konduktiva</span></div>
          <div class="artist"><span class="artist-name">KOHUI</span> — <span class="artist-detail">KR</span></div>
          <div class="artist"><span class="artist-name">MYODIUM</span> — <span class="artist-detail">KZ</span></div>
          <div class="artist"><span class="artist-name">Elvin Brandhi</span> — <span class="artist-detail">UK, noise &amp; voice artist</span></div>
          <div class="artist"><span class="artist-name">Luis Sanz</span> — <span class="artist-detail">CH, live coder &amp; computer musician</span></div>
          <div class="artist"><span class="artist-name">Rangga Purnama Aji</span> — <span class="artist-detail">ID, composer &amp; live coder, Yogyakarta</span></div>
          <div class="artist"><span class="artist-name">Arbor</span> — <span class="artist-detail">CA</span></div>
          <div class="artist"><span class="artist-name">Sippapas Thienwiwat</span> — <span class="artist-detail">TEAMS president, @skykys._</span></div>
          <div class="artist"><span class="artist-name">Internet Cyber Trash</span> — <span class="artist-detail">SAUDADE Collective, @manuth01000</span></div>
          <div class="artist"><span class="artist-name">PALINDROMA</span> — <span class="artist-detail">RU/TH</span></div>
          <div class="artist"><span class="artist-name">Luis Küfner</span> — <span class="artist-detail">DE, live coder &amp; producer, Berlin</span></div>
          <div class="artist"><span class="artist-name">HUE</span> — <span class="artist-detail">ID</span></div>
          <div class="artist"><span class="artist-name">sofolofo</span> — <span class="artist-detail">KR</span></div>
          <div class="artist"><span class="artist-name">inmintcondition</span> — <span class="artist-detail">TH, live coder &amp; algorave artist</span></div>
          <div class="artist"><span class="artist-name">Pradit Saengkrai</span> — <span class="artist-detail">TH, live-electronics musician</span></div>
          <div class="artist"><span class="artist-name">TENGAL</span> — <span class="artist-detail">DE/PH</span></div>
          <div class="artist"><span class="artist-name">kastakila</span> — <span class="artist-detail">US</span></div>
          <div class="artist"><span class="artist-name">Reckoner</span> — <span class="artist-detail">US</span></div>
          <div class="artist"><span class="artist-name">emptyflash</span> — <span class="artist-detail">US, generative artist &amp; live coder</span></div>
