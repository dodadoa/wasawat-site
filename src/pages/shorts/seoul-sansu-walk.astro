---
import Layout from "../../layouts/layout.astro"
---

<Layout title="서울 산수 / walk" description="a watercolor Seoul you walk through by scrolling, one line of the story per leg">
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&display=swap" />
  <div class="ssw-stage">
    <!-- the two friends talk either side of the walk, one column each -->
    <div class="ssw-chat ssw-chat-l" id="ssw-chat-l" aria-live="polite"></div>
    <div class="ssw-phone">
      <canvas
        id="ssw-canvas"
        aria-label="First person walk through a watercolor Seoul. Scroll to walk the story's path, drag to look around."
      ></canvas>
      <div id="ssw-hint">scroll to walk · drag to look</div>
      <div id="ssw-cap">
        <div id="ssw-line"></div>
        <div id="ssw-count"></div>
      </div>
    </div>
    <div class="ssw-chat ssw-chat-r" id="ssw-chat-r" aria-live="polite"></div>
    <div id="ssw-fps"></div>
  </div>
  <!-- the scrollbar is the path: the script sizes this to the length of the walk -->
  <div id="ssw-track" aria-hidden="true"></div>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script is:inline src="/scripts/seoul-sansu-walk.js"></script>
</Layout>

<style>
  .ssw-stage {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    top: 2.5rem;
    --f-ssw: "Gowun Batang", "AppleMyungjo", "Batang", "Noto Serif KR", serif;
    background: #f8f3e7;
    color: #3b302b;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 44px);
    padding: 18px;
  }

  /* the walk is seen through a phone held upright in the middle of the page */
  .ssw-phone {
    position: relative;
    flex: none;
    height: 100%;
    max-width: 100%;
    aspect-ratio: 9 / 19.5;
    border-radius: 34px;
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(59, 48, 43, 0.35),
      0 0 0 7px #f8f3e7,
      0 0 0 8px rgba(59, 48, 43, 0.35),
      0 18px 50px rgba(59, 48, 43, 0.16);
  }

  /* what the friends say: newest at the bottom, older lines drifting up and fading out */
  .ssw-chat {
    flex: 1 1 0;
    min-width: 0;
    max-width: 300px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding-bottom: 12vh;
    overflow: hidden;
    font: 15px/1.45 var(--f-ssw);
    -webkit-mask-image: linear-gradient(to bottom, transparent 4%, #000 38%);
    mask-image: linear-gradient(to bottom, transparent 4%, #000 38%);
  }

  .ssw-chat-l {
    align-items: flex-end;
  }

  .ssw-chat-r {
    align-items: flex-start;
  }

  .ssw-chat :global(p) {
    flex: none;
    margin: 0;
    max-width: 100%;
    padding: 8px 13px;
    border-radius: 15px;
    background: rgba(59, 48, 43, 0.06);
    text-wrap: pretty;
    animation: ssw-say 0.7s ease-out;
  }

  .ssw-chat-l :global(p) {
    border-bottom-right-radius: 4px;
  }

  .ssw-chat-r :global(p) {
    border-bottom-left-radius: 4px;
  }

  /* the other friend's turn: the same words take up the same room, unseen, so the talk zigzags down the two sides */
  .ssw-chat :global(p.gap) {
    visibility: hidden;
  }

  @keyframes ssw-say {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  /* on a real phone the scene is the whole screen, and the talk floats over the top of it
     (a phone on its side is wide but short, so it counts too) */
  @media (max-width: 760px), (max-height: 520px) {
    .ssw-stage {
      padding: 0;
    }

    .ssw-phone {
      width: 100%;
      aspect-ratio: auto;
      border-radius: 0;
      box-shadow: none;
    }

    .ssw-chat {
      position: absolute;
      z-index: 2;
      top: 44px;
      width: 46%;
      height: 24%;
      padding-bottom: 0;
      font-size: 12px;
      pointer-events: none;
    }

    .ssw-chat-l {
      left: 6px;
      align-items: flex-start;
    }

    .ssw-chat-r {
      right: 6px;
      align-items: flex-end;
    }

    .ssw-chat :global(p) {
      background: rgba(248, 243, 231, 0.78);
    }
  }

  #ssw-canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  #ssw-track {
    width: 1px;
    height: 2200vh;
    pointer-events: none;
  }

  #ssw-fps {
    position: absolute;
    left: 10px;
    bottom: calc(8px + env(safe-area-inset-bottom, 0px));
    font: 11px/1 var(--f-pixel);
    opacity: 0.45;
    pointer-events: none;
  }

  #ssw-hint {
    position: absolute;
    left: 50%;
    top: 10px;
    transform: translateX(-50%);
    font: 11px/1 var(--f-ssw);
    letter-spacing: 0.18em;
    white-space: nowrap;
    /* a wash of paper that feathers out, no box */
    background: radial-gradient(ellipse closest-side, rgba(248, 243, 231, 0.8), rgba(248, 243, 231, 0));
    padding: 16px 28px;
    pointer-events: none;
    transition: opacity 0.6s;
  }

  #ssw-hint:global(.gone) {
    opacity: 0;
  }

  #ssw-cap {
    position: absolute;
    left: 50%;
    bottom: calc(22px + env(safe-area-inset-bottom, 0px));
    transform: translateX(-50%);
    width: calc(100% - 8px);
    text-align: center;
    pointer-events: none;
    padding: 24px 26px 18px;
  }

  /* hanji: translucent paper that blurs the scene behind it and dissolves at the edges */
  #ssw-cap::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(248, 243, 231, 0.66);
    -webkit-backdrop-filter: blur(6px) saturate(0.8);
    backdrop-filter: blur(6px) saturate(0.8);
    /* feather all four edges, keep the middle where the words sit */
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 13%, #000 87%, transparent),
      linear-gradient(to bottom, transparent, #000 32%, #000 72%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 13%, #000 87%, transparent),
      linear-gradient(to bottom, transparent, #000 32%, #000 72%, transparent);
    mask-composite: intersect;
  }

  #ssw-line {
    font: 400 15px/1.35 var(--f-ssw);
    letter-spacing: 0.015em;
    text-wrap: balance;
    color: #3b302b;
    text-shadow:
      0 0 14px rgba(248, 243, 231, 0.95),
      0 0 4px rgba(248, 243, 231, 1);
  }

  /* words not walked to yet keep their place but stay unwritten */
  #ssw-line :global(span) {
    opacity: 0;
    filter: blur(4px);
    transition:
      opacity 0.9s ease-out,
      filter 0.9s ease-out;
  }

  #ssw-line :global(span.hit) {
    opacity: 1;
    filter: none;
  }

  #ssw-count {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
    font: 11px/1 var(--f-ssw);
    letter-spacing: 0.3em;
    opacity: 0.55;
  }

  /* brush-thin rules either side of the count */
  #ssw-count::before,
  #ssw-count::after {
    content: "";
    width: 34px;
    height: 1px;
    background: linear-gradient(to right, transparent, currentColor);
  }

  #ssw-count::after {
    transform: scaleX(-1);
  }
</style>
