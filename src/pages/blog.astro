---
import Layout from "../layouts/layout.astro"
let mdPosts: Record<string, any>[] = [];
try {
  mdPosts = await Astro.glob("./blog/posts/*.md");
} catch (error) {
  console.error(error);
}

// interactive posts live as React pages under src/pages/blog/
const pagePosts = [{ url: "/blog/field-notes-stone", frontmatter: { title: "field notes / stone" } }];
const allPosts = [...pagePosts, ...mdPosts];
---

<Layout title="Wasawat Somno's blog" description="blogs">
  <div class="px-8 py-8 font-mono">
    <h1 class="text-3xl">Blogs</h1>
    {
      allPosts.length === 0 && (
        <div class="mt-4">
          <p>No blog post yet.</p>
        </div>
      )
    }
    {
      allPosts.length > 0 && (
        <div class="mt-4">
          {
            allPosts.map((post) => (
              <ul class="cursor-pointer hover:underline mb-4">
                <a href={post.url}>{post.frontmatter.title}</a>
              </ul>
            ))
          }
        </div>
      )
    }
  </div>
</Layout>
