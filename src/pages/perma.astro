---
// /perma: the whole site on one near-plain html page. Home, about, every
// work, news and the CV run down in order, and every link inside jumps to its
// section instead of leaving. Styled after /blog/stones-between: plain html in
// Times on white, 1px black rules, blue links, and the site's bloom.
// Standalone on purpose: no Layout, so no loader, nav or site chrome.
import { experimental_AstroContainer as AstroContainer } from "astro/container"
import CvPage from "./cv.astro"
import { collectSelectedWorks } from "../data/selectedWorks.js"
import { splitNews, formatRange } from "../data/news.js"
import { artSections, artworkPages } from "../data/artArchive.js"
import { bio, fullBio, bioSections } from "../data/about.js"
import { artComponents } from "../subpages/art/index.js"

// a trailing "(2025)" / "(2026–ongoing)" in a label moves into the year column
const works = collectSelectedWorks().map((w) => {
  const m = w.label.match(/^(.*?)\s*\((\d{4}[^)]*)\)$/)
  return { ...w, title: m ? m[1] : w.label, year: m ? m[2] : (w.date?.slice(0, 4) ?? "") }
})
const genres = [...new Set(works.map((w) => w.genre))].map((genre) => ({
  genre,
  works: works.filter((w) => w.genre === genre),
}))

// every work with a page, in archive order, then any the archive doesn't list
const archived = artSections.flatMap((s) =>
  s.groups.flatMap((g) => g.items.filter((i) => i.slug && !i.hidden).map((i) => i.slug)),
)
const pages = [...new Set([...archived, ...Object.keys(artworkPages)])]
  .filter((slug) => artComponents[slug] && artworkPages[slug])
  .map((slug) => ({ slug, title: artworkPages[slug].title, Content: artComponents[slug] }))

const { upcoming, archive } = splitNews()
const newsId = (e) =>
  `news-${e.start}-${e.title.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`

/** A site path as the section of this page that holds it (else unchanged). */
function local(href) {
  if (!href?.startsWith("/")) return href
  const [path, hash] = href.split("#")
  const art = path.match(/^\/art\/([^/]+)\/?$/)
  if (art && artComponents[art[1]]) return `#${hash ?? `art-${art[1]}`}`
  const section = {
    "": "#top",
    "/about": "#about",
    "/work": "#work",
    "/index": "#work",
    "/art": "#work",
    "/news": "#news",
    "/cv": "#cv",
  }[path.replace(/\/$/, "")]
  return section ?? href
}

// the CV is its own standalone page: render it and keep only its body,
// without its header (the name is already at the top here)
const container = await AstroContainer.create()
const cvHtml = ((await container.renderToString(CvPage)).match(/<main[^>]*>([\s\S]*)<\/main>/)?.[1] ?? "")
  .replace(/<header[\s\S]*?<\/header>/, "")
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Wasawat Somno</title>
    <meta name="description" content="Developer/Artist" />
    <!-- global, so the weights below are exactly as written -->
    <style is:global>
      :root {
        color-scheme: light;
        /* the main site's bloom (layout.astro), as on /blog/stones-between */
        --bloom:
          0 0 0.05em color-mix(in srgb, currentColor 50%, transparent),
          0 0 0.4em color-mix(in srgb, currentColor 30%, transparent);
      }

      /* back to the browser's own styles: tailwind's preflight, the work pages'
         own styles and utility classes all lose to an id (inline style= on an
         image still wins, which keeps the pictures sized). Everything below is
         #perma-prefixed and later, so it sits above this. Inline svg keeps its
         own styling. */
      :root,
      #perma,
      #perma :where(:not(svg, svg *)) {
        all: revert;
      }

      /* styled after /blog/stones-between: white page, Times, 1px black rules,
         blue links, the browser's own grey button; no design on top */
      :root,
      #perma {
        background: #fff;
        color: #141414;
      }

      #perma {
        font-family: "Times New Roman", Times, serif;
        font-size: 16px;
        margin: 0;
        padding: 8px max(16px, env(safe-area-inset-left, 0px)) 32px;
      }

      #perma :is(p, li, dd) {
        line-height: 1.45;
      }

      /* the top of the page: about | selected work and news; one column on a phone */
      #perma main {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: 0 2em;
      }

      @media (max-width: 860px) {
        #perma main {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      #perma header p {
        margin-top: -0.4em;
      }

      /* data tables: 1px black rules */
      #perma table {
        width: 100%;
        border-collapse: collapse;
      }

      #perma :is(td, th) {
        border: 1px solid #000;
        padding: 4px;
        text-align: left;
        vertical-align: top;
      }

      #perma td.n {
        text-align: right;
        white-space: nowrap;
      }

      /* pictures and players never wider than the column */
      #perma :is(img, video, iframe) {
        max-width: 100%;
        height: auto;
      }

      /* the work pages' interactive pieces are left out here */
      #perma astro-island {
        display: none;
      }

      /* phone: the kind column goes and the years may wrap, so the tables fit */
      @media (max-width: 560px) {
        #perma .k {
          display: none;
        }

        #perma td.n {
          white-space: normal;
          overflow-wrap: anywhere;
        }
      }

      #perma * {
        text-shadow: var(--bloom);
      }

      /* links stay the default blue: no visited purple, no active red, and
         not the inline colour the work pages give @mentions */
      #perma a:is(:link, :visited, :hover, :active) {
        color: #0000ee !important;
      }
    </style>
  </head>
  <body id="perma">

    <header id="top">
      <h1>Wasawat Somno</h1>
      <p>
        artist — code, audiovisual/sound performance, installation. Bangkok.<br />
        <a href="#about">about</a> · <a href="#work">work</a> · <a href="#news">news</a> ·
        <a href="#cv">cv</a>
      </p>
    </header>

    <hr />

    <main>
      <aside id="about">
        <h2>About</h2>
        {bio.map((text) => <p>{text}</p>)}
        <p><a href="#about-more">more →</a></p>
      </aside>

      <div>
        <h2>Selected work</h2>
        <table>
          <thead>
            <tr><th>no.</th><th>title</th><th>year</th><th class="k">kind</th></tr>
          </thead>
          <tbody>
            {
              genres.map(({ genre, works }) =>
                works.map((w, i) => (
                  <tr>
                    <td class="n">{w.no}</td>
                    <td><a href={local(`/art/${w.slug}`)}>{w.title}</a></td>
                    <td class="n">{w.year}</td>
                    {i === 0 && <td class="k" rowspan={works.length}>{genre}</td>}
                  </tr>
                )),
              )
            }
          </tbody>
        </table>
        <p><a href="#work">full index ↓</a></p>

        <h2>News</h2>
        {upcoming.length === 0 && <p>Nothing scheduled at the moment.</p>}
        {
          upcoming.length > 0 && (
            <table>
              <tbody>
                {upcoming.map((entry) => (
                  <tr>
                    <td class="n">{formatRange(entry.start, entry.end)}</td>
                    <td>
                      <a href={`#${newsId(entry)}`}>{entry.title}</a>
                      {entry.subtitle && <> — <em>{entry.subtitle}</em></>}
                    </td>
                    <td>{entry.venue?.map((v) => v.label).join(", ")}{entry.venueSuffix}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
        <p><a href="#news">all news ↓</a></p>
      </div>
    </main>

    <hr />

    <section id="about-more">
      <h2>About, extended</h2>
      {fullBio.map((html) => <p set:html={html} />)}
      {
        bioSections.map((section) => (
          <>
            <h3>{section.title}</h3>
            <ul>
              {section.items.map((item) => (
                <li>
                  {item.url ? <a href={local(item.url)}>{item.label}</a> : item.label}
                  {item.meta && <> — {item.meta}</>}
                </li>
              ))}
            </ul>
            {section.footnote && <p><small>{section.footnote}</small></p>}
          </>
        ))
      }
    </section>

    <hr />

    <section id="work">
      <h2>Work</h2>
      {
        artSections.map((section) => (
          <>
            <h3>{section.title}</h3>
            {section.groups.map((group) => {
              const items = group.items.filter((item) => !item.hidden)
              return (
                items.length > 0 && (
                  <>
                    {group.title && <h4>{group.title}</h4>}
                    <ul>
                      {items.map((item) => (
                        <li>
                          {item.slug && artComponents[item.slug] ? (
                            <a href={local(`/art/${item.slug}`)}>{item.label}</a>
                          ) : (
                            item.label
                          )}
                          {[item.country, item.date?.slice(0, 4)].filter(Boolean).length > 0 && (
                            <> — {[item.country, item.date?.slice(0, 4)].filter(Boolean).join(", ")}</>
                          )}
                        </li>
                      ))}
                    </ul>
                  </>
                )
              )
            })}
          </>
        ))
      }
    </section>

    {
      pages.map(({ slug, title, Content }) => (
        <>
          <hr />
          <section id={`art-${slug}`}>
            <h2>{title}</h2>
            <p><small><a href="#work">↑ work</a></small></p>
            <Content />
          </section>
        </>
      ))
    }

    <hr />

    <section id="news">
      <h2>News</h2>
      {
        [...upcoming, ...archive].map((entry, i) => (
          <article id={newsId(entry)}>
            {i === upcoming.length && archive.length > 0 && <h3>Archive</h3>}
            <h4>{entry.title}</h4>
            <p>
              {formatRange(entry.start, entry.end)}
              {entry.venue?.map((v) => (
                <>
                  {" · "}
                  {v.href ? <a href={v.href}>{v.label}</a> : v.label}
                </>
              ))}
              {entry.venueSuffix}
            </p>
            {entry.subtitle && <p><em>{entry.subtitle}</em></p>}
            {entry.body?.map((para) => <p set:html={para} />)}
            {entry.meta?.map((line) => <p set:html={line} />)}
            {entry.links?.length > 0 && (
              <ul>
                {entry.links.map((l) => (
                  <li>
                    <a href={local(l.href)}>{l.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </section>

    <hr />

    <section id="cv">
      <h2>CV</h2>
      <Fragment set:html={cvHtml} />
    </section>

    <hr />

    <p><small><a href="#top">↑ top</a> · plain version · <a href="/">full site</a></small></p>

    <!-- the work pages and the CV are written with the site's own paths:
         point any that have a section here at it, so a click only scrolls -->
    <script is:inline>
      const sections = { "": "top", "/about": "about", "/work": "work", "/index": "work", "/art": "work", "/news": "news", "/cv": "cv" }
      for (const a of document.querySelectorAll('a[href^="/"]')) {
        const url = new URL(a.href)
        if (url.origin !== location.origin) continue
        const path = url.pathname.replace(/\/$/, "")
        const art = path.match(/^\/art\/([^/]+)$/)
        const ids = art ? [url.hash.slice(1), `art-${art[1]}`] : [sections[path]]
        const id = ids.find((i) => i && document.getElementById(i))
        if (id) a.setAttribute("href", `#${id}`)
      }
    </script>
  </body>
</html>
