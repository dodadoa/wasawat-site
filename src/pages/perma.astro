---
// /perma: the site as near-plain html. Browser defaults for type, links and
// spacing; only a white ground and the ink (bloom + bleed) are kept.
// Standalone on purpose: no Layout, so no loader, nav, scripts or tailwind.
import { collectSelectedWorks } from "../data/selectedWorks.js"
import { splitNews, formatRange } from "../data/news.js"

// a trailing "(2025)" / "(2026–ongoing)" in a label moves into the year column
const works = collectSelectedWorks().map((w) => {
  const m = w.label.match(/^(.*?)\s*\((\d{4}[^)]*)\)$/)
  return { ...w, title: m ? m[1] : w.label, year: m ? m[2] : (w.date?.slice(0, 4) ?? "") }
})
const genres = [...new Set(works.map((w) => w.genre))].map((genre) => ({
  genre,
  works: works.filter((w) => w.genre === genre),
}))

const { upcoming, archive } = splitNews()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Wasawat Somno</title>
    <meta name="description" content="Developer/Artist" />
    <!-- global, so the weights below are exactly as written -->
    <style is:global>
      :root {
        color-scheme: light;
        /* the same over-inked bloom as the main site (layout.astro) */
        --bloom:
          0 0 0.04em color-mix(in srgb, currentColor 30%, transparent),
          0 0 0.3em color-mix(in srgb, currentColor 14%, transparent);
      }

      /* tailwind's preflight is injected into every page: undo it back to the
         browser's own styles. Just heavier than preflight's bare element
         selectors; everything below is prefixed with :root to sit above it.
         The filter svg keeps its own sizing. */
      :root,
      html :not(svg, svg *) {
        all: revert;
      }

      :root,
      :root body {
        background: #fff;
        color: #141414;
      }

      :root body {
        font-size: 20px;
        max-width: 1180px;
        margin: 0 auto;
        padding: 1em 1.25em 2em;
      }

      /* two columns: about | work and news; one on a phone */
      :root main {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: 0 3em;
      }

      @media (max-width: 860px) {
        :root main {
          grid-template-columns: minmax(0, 1fr);
        }
      }

      /* phone: the kind column goes and the years may wrap, so the tables fit */
      @media (max-width: 560px) {
        :root .k {
          display: none;
        }

        :root td.n {
          white-space: normal;
          overflow-wrap: anywhere;
        }

        :root body {
          padding-inline: 16px;
        }
      }

      :root header p {
        margin-top: -0.4em;
      }

      /* data tables: ruled, as table border="1" would draw them */
      :root table {
        width: 100%;
        border-collapse: collapse;
      }

      :root :is(td, th) {
        border: 1px solid #141414;
        padding: 0.2em 0.45em;
        text-align: left;
        vertical-align: top;
      }

      :root td.n {
        text-align: right;
        white-space: nowrap;
      }

      :root aside p {
        font-size: 0.9em;
      }

      :root * {
        text-shadow: var(--bloom);
      }

      /* links stay the default blue: no visited purple, no active red */
      :root a:is(:link, :visited, :hover, :active) {
        color: #0000ee;
      }

      /* bleed per text block (never on a block inside another, or it doubles) */
      :root h1 {
        filter: url(#ink-body);
      }

      :root :is(h2, h3, p, li, dt, dd, summary, td, th) {
        filter: url(#ink-small);
      }
    </style>
  </head>
  <body>
    <!-- ink-bleed filters after layout.astro's (blur → warp by coarse noise →
         threshold back to a hard edge → fine grain → over a bloom), turned
         down: less blur and warp, a fainter bloom -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <defs>
        <filter id="ink-body" x="-6%" y="-40%" width="112%" height="180%" color-interpolation-filters="sRGB">
          <feGaussianBlur in="SourceGraphic" stdDeviation="0.8" result="blur" />
          <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="warp" />
          <feDisplacementMap in="blur" in2="warp" scale="1.8" xChannelSelector="R" yChannelSelector="G" result="warped" />
          <feComponentTransfer in="warped" result="hard">
            <feFuncA type="linear" slope="6" intercept="-2.02" />
          </feComponentTransfer>
          <feTurbulence type="fractalNoise" baseFrequency="0.95" numOctaves="1" seed="13" result="grain" />
          <feDisplacementMap in="hard" in2="grain" scale="0.9" xChannelSelector="R" yChannelSelector="G" result="ink" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="3.5" result="wide" />
          <feComponentTransfer in="wide" result="bloom">
            <feFuncA type="linear" slope="0.22" />
          </feComponentTransfer>
          <feMerge><feMergeNode in="bloom" /><feMergeNode in="ink" /></feMerge>
        </filter>
        <filter id="ink-small" x="-6%" y="-45%" width="112%" height="190%" color-interpolation-filters="sRGB">
          <feGaussianBlur in="SourceGraphic" stdDeviation="0.45" result="blur" />
          <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="2" seed="9" result="warp" />
          <feDisplacementMap in="blur" in2="warp" scale="1" xChannelSelector="R" yChannelSelector="G" result="warped" />
          <feComponentTransfer in="warped" result="hard">
            <feFuncA type="linear" slope="6" intercept="-2.02" />
          </feComponentTransfer>
          <feTurbulence type="fractalNoise" baseFrequency="1.1" numOctaves="1" seed="17" result="grain" />
          <feDisplacementMap in="hard" in2="grain" scale="0.5" xChannelSelector="R" yChannelSelector="G" result="ink" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="2.5" result="wide" />
          <feComponentTransfer in="wide" result="bloom">
            <feFuncA type="linear" slope="0.2" />
          </feComponentTransfer>
          <feMerge><feMergeNode in="bloom" /><feMergeNode in="ink" /></feMerge>
        </filter>
      </defs>
    </svg>

    <header>
      <h1>Wasawat Somno</h1>
      <p>
        artist — code, audiovisual/sound performance, installation. Bangkok.<br />
        <a href="/">home</a> · <a href="/news">news</a> · <a href="/work">work</a> ·
        <a href="/about">about</a> · <a href="/cv">cv</a>
      </p>
    </header>

    <hr />

    <main>
      <aside>
        <h2>About</h2>
        <p>
          Wasawat Somno (1994, Thailand) is an artist working with code, audiovisual/sound performance, and
          installation. His practice is organized around the act of mapping — holding two planes of context in
          tension and tracing what passes between them. A computational system and the ethical questions it
          quietly carries. A simulation and the physical world it stands in for. An interface and the body that
          encounters it.
        </p>
        <p>
          His work constructs situations where these double registers become navigable: spaces where narrative
          bleeds across layers, where expectation bends, and where the logic of a system begins to press against
          something more speculative. Working across installation, audiovisual/sound performance, and net art, he
          is drawn to the threshold where the technical and the ethical fold into each other — where a worm's
          connectome becomes a question about consciousness, where a screen holds more than what it displays.
        </p>
        <p>
          The work holds a deliberately semi-serious structure — rigorous in its systems, amateur in its posture,
          sustained by the spirit of DIY.
        </p>
        <p><a href="/about">more →</a></p>
      </aside>

      <div>
        <h2>Selected work</h2>
        <table>
          <thead>
            <tr><th>no.</th><th>title</th><th>year</th><th class="k">kind</th></tr>
          </thead>
          <tbody>
            {
              genres.map(({ genre, works }) =>
                works.map((w, i) => (
                  <tr>
                    <td class="n">{w.no}</td>
                    <td><a href={`/art/${w.slug}`}>{w.title}</a></td>
                    <td class="n">{w.year}</td>
                    {i === 0 && <td class="k" rowspan={works.length}>{genre}</td>}
                  </tr>
                )),
              )
            }
          </tbody>
        </table>
        <p><a href="/work">full index →</a></p>

        <h2>News</h2>
        {upcoming.length === 0 && <p>Nothing scheduled at the moment.</p>}
        {
          upcoming.length > 0 && (
            <table>
              <tbody>
                {upcoming.map((entry) => (
                  <tr>
                    <td class="n">{formatRange(entry.start, entry.end)}</td>
                    <td>
                      {entry.links?.[0] ? <a href={entry.links[0].href}>{entry.title}</a> : entry.title}
                      {entry.subtitle && <> — <em>{entry.subtitle}</em></>}
                    </td>
                    <td>{entry.venue?.map((v) => v.label).join(", ")}{entry.venueSuffix}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )
        }
        {
          archive.length > 0 && (
            <details>
              <summary>archive ({archive.length})</summary>
              <table>
                <tbody>
                  {archive.map((entry) => (
                  <tr>
                    <td class="n">{formatRange(entry.start, entry.end)}</td>
                    <td>
                      {entry.links?.[0] ? <a href={entry.links[0].href}>{entry.title}</a> : entry.title}
                      {entry.subtitle && <> — <em>{entry.subtitle}</em></>}
                    </td>
                    <td>{entry.venue?.map((v) => v.label).join(", ")}{entry.venueSuffix}</td>
                  </tr>
                ))}
                </tbody>
              </table>
            </details>
          )
        }
        <p><a href="/news">all news →</a></p>
      </div>
    </main>

    <hr />

    <p><small>plain version · <a href="/">full site</a></small></p>
  </body>
</html>
