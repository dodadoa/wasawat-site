---
import Layout from "../layouts/layout.astro"
import { artSections } from "../data/artArchive.js"
---

<Layout title="Wasawat Somno's art projects">
  <div class="relative z-10 font-mono p-8 pb-20 max-w-4xl">
    <p class="text-[12px] uppercase tracking-widest mb-2" style="color: var(--text-dim);">[archives]</p>
    <h1 class="font-bold text-3xl lg:text-4xl mb-10" style="color: var(--text);">Archives</h1>

    {
      artSections.map((section) => (
        <section class="mb-10">
          <h2 class="font-bold text-xl mb-4 uppercase tracking-wide" style="color: var(--text);">{section.title}</h2>

          {section.groups.map((group) => (
            <div class="mb-6 ml-4">
              {group.title && <h3 class="text-[13px] uppercase tracking-widest mb-2" style="color: var(--text-dim);">{group.title}</h3>}
              <ul class="list-disc ml-4">
                {group.items.map((item) => (
                  <li class="mt-2">
                    {item.slug ? (
                      <a href={`/art/${item.slug}`} class="hover:underline">
                        {item.label}
                      </a>
                    ) : (
                      item.label
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      ))
    }
  </div>
</Layout>
