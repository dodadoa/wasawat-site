---
import Layout from "../../layouts/layout.astro"
import { artSections } from "../../data/artArchive.js"
import installations from "../../data/genres/installations.js"
import netart from "../../data/genres/netart.js"
import performance from "../../data/genres/performance.js"

const allWorks = [...installations.works, ...netart.works, ...performance.works]

const dateBySlug = Object.fromEntries(
  allWorks.filter((w) => w.slug && w.date).map((w) => [w.slug, w.date]),
)

const imageBySlug = Object.fromEntries(
  allWorks.filter((w) => w.slug && w.image).map((w) => [w.slug, w.image]),
)

/** Split a section's groups into selected (has a page) and unselected rows, keeping group titles */
function splitSection(section) {
  const selected = []
  const unselected = []
  for (const group of section.groups) {
    for (const item of group.items) {
      const row = { item, groupTitle: group.title }
      if (item.slug) selected.push(row)
      else unselected.push(row)
    }
  }
  return { selected, unselected }
}
---

<Layout title="Index — Wasawat Somno" description="Index of works">
  <div class="relative z-10 font-mono p-8 pb-20 max-w-4xl">
    <p class="text-[12px] uppercase tracking-widest mb-2" style="color: var(--text-dim);">[index]</p>
    <h1 class="font-bold text-3xl lg:text-4xl mb-10" style="color: var(--text);">Index</h1>

    {
      artSections.map((section) => {
        const { selected, unselected } = splitSection(section)
        return (
          <section class="mb-14">
            <h2 class="font-bold text-xl mb-4 uppercase tracking-wide" style="color: var(--text);">{section.title}</h2>

            {selected.length > 0 && (
              <>
                <p class="text-[11px] uppercase tracking-widest mb-2" style="color: var(--text-dim);">Selected</p>
                <table class="w-full text-[13px] border-collapse mb-8">
                  <thead>
                    <tr style="border-bottom: 1px solid var(--border-subtle);">
                      <th class="text-left font-normal py-2 pr-4" style="width: 56px;"></th>
                      <th class="text-left font-normal uppercase tracking-widest py-2 pr-4" style="color: var(--text-dim); font-size: 11px;">Title</th>
                      <th class="text-left font-normal uppercase tracking-widest py-2 pr-4" style="color: var(--text-dim); font-size: 11px;">Group</th>
                      <th class="text-right font-normal uppercase tracking-widest py-2" style="color: var(--text-dim); font-size: 11px;">Year</th>
                    </tr>
                  </thead>
                  <tbody>
                    {selected.map(({ item, groupTitle }) => {
                      const date = dateBySlug[item.slug]
                      const image = imageBySlug[item.slug]
                      return (
                        <tr style="border-bottom: 1px solid var(--border-subtle);">
                          <td class="py-2 pr-4">
                            {image ? (
                              <img
                                src={image}
                                alt=""
                                loading="lazy"
                                style="width: 44px; height: 32px; object-fit: cover; display: block;"
                              />
                            ) : (
                              <div style="width: 44px; height: 32px; background: var(--border-subtle);" />
                            )}
                          </td>
                          <td class="py-2 pr-4" style="color: var(--text-muted);">
                            <a href={`/art/${item.slug}`} class="hover:underline">
                              {item.label}
                            </a>
                          </td>
                          <td class="py-2 pr-4" style="color: var(--text-dim);">
                            {groupTitle ?? "—"}
                          </td>
                          <td class="py-2 text-right" style="color: var(--text-dim);">
                            {date ? date.slice(0, 4) : "—"}
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
              </>
            )}

            {unselected.length > 0 && (
              <>
                <p class="text-[11px] uppercase tracking-widest mb-2" style="color: var(--text-dim);">Archive</p>
                <table class="w-full text-[13px] border-collapse">
                  <tbody>
                    {unselected.map(({ item, groupTitle }) => (
                      <tr style="border-bottom: 1px solid var(--border-subtle);">
                        <td class="py-2 pr-4" style="color: var(--text-muted);">
                          {item.label}
                        </td>
                        <td class="py-2 pr-4" style="color: var(--text-dim); width: 180px;">
                          {groupTitle ?? "—"}
                        </td>
                        <td class="py-2 text-right" style="color: var(--text-dim); width: 60px;">
                          —
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </>
            )}
          </section>
        )
      })
    }
  </div>
</Layout>
