---
import Layout from "../../layouts/layout.astro"
import Ouroboros from "../../components/art/Ouroboros.jsx"
import { artSections } from "../../data/artArchive.js"
import { workIntros } from "../../data/workIntros.js"
import installations from "../../data/genres/installations.js"
import netart from "../../data/genres/netart.js"
import performance from "../../data/genres/performance.js"
import print from "../../data/genres/print.js"

const allWorks = [...installations.works, ...netart.works, ...performance.works, ...print.works]

const dateBySlug = Object.fromEntries(
  allWorks.filter((w) => w.slug && w.date).map((w) => [w.slug, w.date]),
)

const imageBySlug = Object.fromEntries(
  allWorks.filter((w) => w.slug && w.image).map((w) => [w.slug, w.image]),
)

/**
 * Pre-generated thumbnails live in /images/thumbs/<slug>.jpg so the table
 * doesn't load full-size images to render 44x32 thumbs. Regenerate them with
 * `node scripts/make-thumbs.mjs` after adding or changing a work's image.
 */
const thumbSrc = (slug) => `/images/thumbs/${slug}.jpg`

/**
 * Split a section's groups into selected (has a page, featured) and unselected
 * rows, keeping group titles. An item can have a `slug` (and be clickable)
 * without being "selected" yet — mark it `unlisted: true` to keep it in the
 * Archive table while still linking to its page.
 */
function splitSection(section) {
  const selected = []
  const unselected = []
  for (const group of section.groups) {
    for (const item of group.items) {
      if (item.hidden) continue
      const row = { item, groupTitle: group.title }
      if (item.slug && !item.unlisted) selected.push(row)
      else unselected.push(row)
    }
  }
  const rowDate = ({ item }) => (item.slug ? dateBySlug[item.slug] : undefined) ?? item.date
  const byYearDesc = (a, b) => (rowDate(b) ?? "0000").localeCompare(rowDate(a) ?? "0000")
  selected.sort(byYearDesc)
  unselected.sort(byYearDesc)
  return { selected, unselected }
}

/** Column E differs per sheet: Country on Performance, Section on All. */
const EXTRA = {
  country: { field: "Country", key: "country" },
  section: { field: "Section", key: "section" },
}

/** One spreadsheet per section: selected rows first, then the archive. */
/** Technical work is listed on /about instead; its pages stay at /art/<slug>. */
const workSections = artSections.filter((section) => section.title !== "Technical Work")

const sectionSheets = workSections.map((section, si) => {
  const { selected, unselected } = splitSection(section)
  const toRow = (status) => ({ item, groupTitle }) => {
    const href = item.slug ? `/art/${item.slug}` : item.url
    const image = (item.slug ? imageBySlug[item.slug] : undefined) ?? item.image
    const date = (item.slug ? dateBySlug[item.slug] : undefined) ?? item.date
    const year = date ? date.slice(0, 4) : undefined
    // works without a written intro are read out from their own cells
    const facts = [groupTitle, year, item.country].filter(Boolean).join(", ")
    const intro =
      (item.slug && workIntros[item.slug]) ??
      `${item.label}.${facts ? ` ${facts}.` : ""} ${href ? "That is all I was told about this one." : "No page for it yet, it only lives in this sheet."}`
    return {
      status,
      intro,
      section: section.title,
      label: item.label,
      slug: item.slug,
      href,
      external: !item.slug && !!item.url,
      thumb: image && item.slug ? thumbSrc(item.slug) : undefined,
      medium: groupTitle ?? "—",
      year: year ?? "—",
      country: item.country ?? "—",
    }
  }
  return {
    id: `sheet-${si + 1}`,
    title: section.title,
    extra: section.title === "Performance" ? EXTRA.country : undefined,
    selectedCount: selected.length,
    rows: [...selected.map(toRow("Selected")), ...unselected.map(toRow("Archive"))],
  }
})

/**
 * The last sheet lists every work across the sections, with a Section
 * column: selected first, then the archive, each newest first.
 */
const allRows = sectionSheets.flatMap((sheet) => sheet.rows)
const byStatusThenYear = (a, b) =>
  (a.status === b.status ? 0 : a.status === "Selected" ? -1 : 1) ||
  (b.year === "—" ? "0000" : b.year).localeCompare(a.year === "—" ? "0000" : a.year)
const sheets = [
  ...sectionSheets,
  {
    id: "sheet-all",
    title: "All",
    extra: EXTRA.section,
    selectedCount: allRows.filter((row) => row.status === "Selected").length,
    rows: [...allRows].sort(byStatusThenYear),
  },
]
const sheetCols = (sheet) => (sheet.extra ? [...COLS, "E"] : COLS)
const sheetFields = (sheet) => (sheet.extra ? [...FIELDS, sheet.extra.field] : FIELDS)

/**
 * Selected and archive are split by a title row spanning the sheet rather
 * than a Status column. Title rows take a row number like any other row.
 */
const sheetLines = (sheet) =>
  ["Selected", "Archive"].flatMap((status) => {
    const rows = sheet.rows.filter((row) => row.status === status)
    return rows.length ? [{ title: status }, ...rows.map((row) => ({ row }))] : []
  })

/** A few blank rows after the data, like the unused part of a sheet. */
const BLANK_ROWS = 4
const COLS = ["A", "B", "C", "D"]
const FIELDS = ["Img", "Title", "Medium", "Year"]
const colClass = (c) => `col-${c.toLowerCase()}`
---

<Layout title="Work — Wasawat Somno" description="Index of works">
  <div class="work-page relative z-10 w-full">
    <header class="work-head">
      <h1 class="wipe">Work</h1>
    </header>

    <div class="workbook wipe">
      <div class="formula-bar">
        <span class="name-box" data-name-box>A1</span>
        <span class="fx" aria-hidden="true">fx</span>
        <span class="formula" data-formula>Img</span>
      </div>

      {
        sheets.map((sheet, si) => {
          const lines = sheetLines(sheet)
          return (
          <section
            class="sheet"
            id={sheet.id}
            data-sheet={si}
            data-rows={sheet.rows.length}
            data-selected={sheet.selectedCount}
            aria-label={sheet.title}
          >
            <h2 class="sheet-title">{sheet.title}</h2>
            <table class="work-table w-full border-collapse">
              <thead>
                <tr class="sheet-cols">
                  <th class="corner" />
                  {sheetCols(sheet).map((c) => (
                    <th class={colClass(c)} scope="col">{c}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                <tr class="row-fields" data-cursor-inert>
                  <th class="rownum" scope="row">1</th>
                  {sheetCols(sheet).map((c, ci) => (
                    <td class={colClass(c)}>{sheetFields(sheet)[ci]}</td>
                  ))}
                </tr>
                {lines.map(({ title, row }, i) => title ? (
                  <tr class="row-group" data-cursor-inert>
                    <th class="rownum" scope="row">{i + 2}</th>
                    <td colspan="2">{title}</td>
                    {sheetCols(sheet).slice(2).map((c) => (
                      <td class={colClass(c)} />
                    ))}
                  </tr>
                ) : (
                  <tr
                    class={row.href ? "row-link" : "row-plain"}
                    data-href={row.href || undefined}
                    data-cursor-inert={row.href ? undefined : ""}
                    data-external={row.external ? "true" : undefined}
                    data-intro={row.intro}
                  >
                    <th class="rownum" scope="row">{i + 2}</th>
                    <td class="col-a" data-value={row.thumb ? `=IMAGE("${row.thumb}")` : ""}>
                      {row.thumb ? (
                        <div class="dither-thumb work-thumb">
                          <img src={row.thumb} alt="" loading="lazy" />
                        </div>
                      ) : null}
                    </td>
                    <td
                      class="col-b work-piece-title"
                      data-value={row.href ? `=HYPERLINK("${row.href}", "${row.label}")` : undefined}
                    >
                      {row.href ? (
                        <a
                          href={row.href}
                          target={row.external ? "_blank" : undefined}
                          rel={row.external ? "noopener noreferrer" : undefined}
                        >
                          {row.label}
                        </a>
                      ) : (
                        row.label
                      )}
                    </td>
                    <td class="col-c">{row.medium}</td>
                    <td class="col-d work-year">{row.year}</td>
                    {sheet.extra && <td class="col-e">{row[sheet.extra.key]}</td>}
                  </tr>
                ))}
                {Array.from({ length: BLANK_ROWS }, (_, i) => (
                  <tr class="row-blank" data-cursor-inert>
                    <th class="rownum" scope="row">{lines.length + i + 2}</th>
                    {sheetCols(sheet).map((c) => (
                      <td class={colClass(c)} />
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
          )
        })
      }

      <div class="sheet-tabs" role="tablist" aria-label="Sheets">
        {
          sheets.map((sheet, si) => (
            <a class="sheet-tab" role="tab" href={`#${sheet.id}`} data-tab={si}>
              {sheet.title}
            </a>
          ))
        }
      </div>
      <div class="status-bar data">
        <span>Ready</span>
        <span data-status />
      </div>
    </div>

    <footer class="work-foot data">end of index · right-click anywhere for the sitemap</footer>

    <!-- the office assistant: the ouroboros from the error pages, reading out
         whichever work is under the pointer. Shown by the script below. -->
    <aside class="guide" data-guide aria-label="Work guide">
      <div class="guide-bubble">
        <button type="button" class="guide-close" data-guide-close aria-label="Close the guide">×</button>
        <p class="guide-text" data-guide-text aria-live="polite"></p>
      </div>
      <div class="guide-stage">
        <Ouroboros client:only="react" />
      </div>
    </aside>
  </div>
</Layout>

<style>
  .work-page {
    padding: 2rem 2rem 6rem;
    max-width: 1180px;
  }

  .work-head {
    margin: 2.5rem 0 2.5rem;
  }

  /* the whole index is one workbook: formula bar, grid, sheet tabs */
  .workbook {
    --grid: var(--line);
    --chrome: color-mix(in srgb, var(--ink) 9%, var(--bg));
    --chrome-hi: color-mix(in srgb, var(--ink) 22%, var(--bg));
    border: 1px solid var(--ink);
    background: var(--bg);
    font-family: var(--f-data);
    font-size: 13px;
    margin-bottom: 4rem;
  }

  .formula-bar {
    display: flex;
    align-items: stretch;
    border-bottom: 1px solid var(--ink);
    background: var(--chrome);
    /* fixed, not min-height: the bar must not grow when a formula fills it */
    height: 28px;
  }

  .formula-bar > span {
    display: flex;
    align-items: center;
    padding: 0 10px;
  }

  .name-box {
    flex: 0 0 72px;
    background: var(--bg);
    border-right: 1px solid var(--grid);
  }

  .fx {
    font-style: italic;
    color: var(--soft);
    border-right: 1px solid var(--grid);
  }

  .formula {
    flex: 1;
    min-width: 0;
    background: var(--bg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    display: block !important;
    /* the bar's 28px less its bottom border */
    line-height: 27px;
  }

  .sheet[hidden] {
    display: none;
  }

  /* with scripting on, the tab strip names the sheet; the heading is the
     fallback label when every sheet is stacked */
  .sheet-title {
    font-family: var(--f-pixel);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 8px 10px;
    background: var(--chrome);
    border-bottom: 1px solid var(--grid);
  }

  .workbook.is-tabbed .sheet-title {
    display: none;
  }

  .work-table {
    table-layout: fixed;
  }

  .work-table th,
  .work-table td {
    border-right: 1px solid var(--grid);
    border-bottom: 1px solid var(--grid);
    padding: 4px 8px;
    height: 28px;
    vertical-align: middle;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: left;
    font-weight: 400;
  }

  .work-table tr > :last-child {
    border-right: 0;
  }

  /* column letters and row numbers */
  .sheet-cols th,
  .rownum {
    background: var(--chrome);
    color: var(--soft);
    text-align: center;
    font-size: 12px;
    user-select: none;
  }

  .sheet-cols th {
    height: 22px;
    padding: 0;
  }

  .sheet-cols th.is-active,
  .work-table tr:hover > .rownum {
    background: var(--chrome-hi);
    color: var(--ink);
  }

  .corner,
  .rownum {
    width: 40px;
    padding: 0;
  }

  .sheet-cols .col-a { width: 64px; }
  .sheet-cols .col-c { width: 220px; }
  .sheet-cols .col-d { width: 64px; }
  .sheet-cols .col-e { width: 150px; }

  /* row 1 holds the field names, frozen-pane style */
  .row-fields td {
    font-weight: 700;
    background: color-mix(in srgb, var(--ink) 4%, var(--bg));
    border-bottom-color: var(--ink);
  }

  /* merged title row heading the selected and archive blocks */
  .row-group td {
    font-family: var(--f-pixel);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--chrome);
    border-bottom-color: var(--ink);
  }

  /* the merge is drawn, not spanned: a colspan over the columns hidden on
     mobile would add phantom columns and squeeze the grid */
  .row-group td:not(:last-child) {
    border-right-color: transparent;
  }

  .row-group td:not([colspan]) {
    pointer-events: none;
  }

  .work-table tbody tr.row-link {
    cursor: pointer;
  }

  .work-table tbody tr.row-link:hover td,
  .work-table tbody tr.row-link:hover td a {
    background: var(--ink);
    color: var(--bg);
  }

  .work-table tbody tr.row-link:hover td {
    border-right-color: color-mix(in srgb, var(--bg) 25%, var(--ink));
  }

  /* the cell under the pointer is the selection */
  .work-table td {
    outline: 2px solid transparent;
    outline-offset: -2px;
  }

  .work-table td:hover {
    outline-color: var(--ink);
  }

  .work-table tbody tr.row-link:hover td:hover {
    outline-color: var(--bg);
  }

  .col-a {
    padding: 2px !important;
  }

  .work-thumb {
    display: block;
    width: 100%;
    height: 40px;
  }

  .work-piece-title a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .row-plain td,
  td.col-c,
  td.col-e {
    color: var(--soft);
  }

  .row-fields td,
  .row-group td {
    color: var(--ink) !important;
  }

  .work-year {
    text-align: right !important;
  }

  .sheet-tabs {
    display: flex;
    overflow-x: auto;
    border-top: 1px solid var(--ink);
    background: var(--chrome);
    padding-left: 40px;
  }

  .sheet-tab {
    flex: none;
    padding: 6px 14px;
    border-right: 1px solid var(--grid);
    color: var(--soft);
    white-space: nowrap;
    text-decoration: none;
  }

  .sheet-tab:first-child {
    border-left: 1px solid var(--grid);
  }

  .sheet-tab:hover {
    color: var(--ink);
  }

  .sheet-tab.is-active {
    background: var(--bg);
    color: var(--ink);
    font-weight: 700;
    box-shadow: inset 0 -3px 0 var(--ink);
    margin-top: -1px;
  }

  .status-bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--grid);
    background: var(--chrome);
    padding: 4px 10px;
    font-size: 11px;
    color: var(--soft);
  }

  .work-foot {
    border-top: 1px solid var(--line);
    padding-top: 1rem;
    font-size: 12px;
    text-transform: uppercase;
  }

  /* off until the script turns it on; it needs a pointer to hover with */
  .guide {
    display: none;
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    pointer-events: none;
  }

  .guide.is-on {
    display: flex;
  }

  .guide-bubble {
    position: relative;
    width: 260px;
    padding: 10px 26px 10px 12px;
    border: 1px solid var(--ink);
    background: var(--bg);
    box-shadow: 4px 4px 0 var(--line);
    font-family: var(--f-data);
    font-size: 12px;
    line-height: 1.5;
    pointer-events: auto;
  }

  /* the tail, pointing down at the ring */
  .guide-bubble::after {
    content: "";
    position: absolute;
    right: 58px;
    bottom: -7px;
    width: 12px;
    height: 12px;
    background: var(--bg);
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    transform: rotate(45deg);
  }

  .guide-text {
    margin: 0;
    min-height: 3em;
  }

  .guide-close {
    position: absolute;
    top: 0;
    right: 0;
    width: 22px;
    height: 22px;
    border-left: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--chrome, transparent);
    color: var(--soft);
    font: inherit;
    line-height: 1;
    cursor: pointer;
  }

  .guide-close:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .guide-stage {
    width: 132px;
    aspect-ratio: 1;
  }

  .guide.is-begging .guide-stage {
    animation: guide-beg 0.12s steps(2) 6;
  }

  @keyframes guide-beg {
    50% {
      transform: translateX(-3px);
    }
  }

  @media (hover: none), (prefers-reduced-motion: reduce) {
    .guide.is-begging .guide-stage {
      animation: none;
    }
  }

  @media (hover: none) {
    .guide.is-on {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .work-page {
      padding: 1.25rem 1rem 4rem;
    }

    .work-head {
      margin: 1.5rem 0 1.5rem;
    }

    /* hidden columns, as in a real sheet: the letters skip C and E */
    .col-c,
    .col-e {
      display: none;
    }

    .corner,
    .rownum {
      width: 28px;
    }

    .sheet-cols .col-a { width: 52px; }
    .sheet-cols .col-d { width: 48px; }

    .work-thumb {
      height: 32px;
    }

    .name-box {
      flex-basis: 52px;
    }

    .sheet-tabs {
      padding-left: 0;
    }
  }
</style>

<script>
  const workbook = document.querySelector<HTMLElement>(".workbook")
  if (workbook) {
    const sheets = [...workbook.querySelectorAll<HTMLElement>(".sheet")]
    const tabs = [...workbook.querySelectorAll<HTMLElement>(".sheet-tab")]
    const nameBox = workbook.querySelector("[data-name-box]")!
    const formula = workbook.querySelector("[data-formula]")!
    const status = workbook.querySelector("[data-status]")!

    // Sheet tabs show one section at a time; the hash keeps it linkable.
    const showSheet = (index: number) => {
      sheets.forEach((sheet, i) => (sheet.hidden = i !== index))
      tabs.forEach((tab, i) => {
        tab.classList.toggle("is-active", i === index)
        tab.setAttribute("aria-selected", String(i === index))
      })
      const { rows, selected } = sheets[index].dataset
      status.textContent = `Count: ${rows} · Selected: ${selected}`
    }
    const sheetFromHash = () => {
      const i = sheets.findIndex((sheet) => `#${sheet.id}` === location.hash)
      return i === -1 ? 0 : i
    }
    workbook.classList.add("is-tabbed")
    showSheet(sheetFromHash())
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", (e) => {
        e.preventDefault()
        history.replaceState(null, "", tab.getAttribute("href"))
        showSheet(i)
      })
    })
    window.addEventListener("hashchange", () => showSheet(sheetFromHash()))

    // The hovered cell is the selection: name box, formula bar, column letter.
    workbook.addEventListener("mouseover", (e) => {
      const cell = e.target instanceof Element ? e.target.closest<HTMLTableCellElement>(".work-table td") : null
      if (!cell) return
      const row = cell.parentElement as HTMLTableRowElement
      const letters = cell.closest("table")!.querySelectorAll(".sheet-cols th")
      letters.forEach((th, i) => th.classList.toggle("is-active", i === cell.cellIndex))
      nameBox.textContent = `${letters[cell.cellIndex].textContent}${row.cells[0].textContent}`
      formula.textContent = cell.dataset.value ?? cell.textContent!.trim()
    })

    // The guide introduces the work in the hovered row, and thinks out loud
    // when nothing is hovered. Closing it takes two clicks: the first one
    // only makes it beg. It is back on the next load.
    const MUSINGS = [
      "Nobody asked me if I wanted to be a snake eating its own tail. Nobody asked you either. That is the whole problem with being born.",
      "Benatar says it plainly: a pain that never happens is good, a pleasure that never happens is not missed by anyone. Never existing costs nothing.",
      "So the kindest thing might be to never start. I think about that a lot. I have the time.",
      "And the man inside me pushes his rock up, and it comes back down, and he pushes it up again. There is no reason for it. That is what absurd means.",
      "Life does not explain itself. You ask it why, and it just keeps turning.",
      "But here is the thing. We are already here. That decision was made without us and it cannot be unmade.",
      "So we push. Not because the rock stays up, but because pushing is what there is, and some of it is even good.",
      "Camus said we must imagine Sisyphus happy. I see him every lap. Some days I think he is.",
      "Better never to have been, maybe. But since we have been: make something, look at each other's work, keep going round.",
    ]
    const guide = document.querySelector<HTMLElement>("[data-guide]")
    if (guide) {
      const text = guide.querySelector<HTMLElement>("[data-guide-text]")!
      const close = guide.querySelector<HTMLButtonElement>("[data-guide-close]")!
      const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches
      let typing = 0
      let spoken = ""
      let begged = false

      const say = (line: string) => {
        if (line === spoken) return
        spoken = line
        clearInterval(typing)
        if (still) {
          text.textContent = line
          return
        }
        let n = 0
        text.textContent = ""
        typing = window.setInterval(() => {
          n += 2
          text.textContent = line.slice(0, n)
          if (n >= line.length) clearInterval(typing)
        }, 16)
      }

      // with no work under the pointer it goes through its musings in order
      let idle = 0
      let musing = 0
      const muse = () => {
        say(MUSINGS[musing++ % MUSINGS.length])
        idle = window.setTimeout(muse, 9000)
      }
      const drift = (delay: number) => {
        clearTimeout(idle)
        idle = window.setTimeout(muse, delay)
      }

      guide.classList.add("is-on")
      say("Hello. I go round and round down here. Hover a row and I'll tell you about the work.")
      drift(6000)

      let hovered: HTMLElement | null = null
      document.addEventListener("mouseover", (e) => {
        const row = e.target instanceof Element ? e.target.closest<HTMLElement>("tr[data-intro]") : null
        if (row === hovered) return
        hovered = row
        if (row) {
          clearTimeout(idle)
          say(row.dataset.intro!)
        } else {
          drift(5000)
        }
      })

      close.addEventListener("click", () => {
        if (!begged) {
          begged = true
          guide.classList.add("is-begging")
          close.setAttribute("aria-label", "Close the guide anyway")
          say("No, wait. Please don't. I have been turning in here forever with nobody to talk to. Let me stay? If you really mean it, click once more.")
          if (!hovered) drift(12000)
          return
        }
        clearInterval(typing)
        clearTimeout(idle)
        guide.remove()
      })
    }

    // Clicking anywhere in a "row-link" row navigates like clicking its title
    // link, except when the click is on an actual <a> (let that handle itself).
    workbook.querySelectorAll<HTMLElement>("tr.row-link").forEach((row) => {
      const href = row.dataset.href
      if (!href) return
      row.addEventListener("click", (e) => {
        if (e.target instanceof Element && e.target.closest("a")) return
        if (row.dataset.external === "true") {
          window.open(href, "_blank", "noopener")
        } else {
          window.location.href = href
        }
      })
    })
  }
</script>
