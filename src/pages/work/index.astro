---
import Layout from "../../layouts/layout.astro"
import { artSections } from "../../data/artArchive.js"
import installations from "../../data/genres/installations.js"
import netart from "../../data/genres/netart.js"
import performance from "../../data/genres/performance.js"

const allWorks = [...installations.works, ...netart.works, ...performance.works]

const dateBySlug = Object.fromEntries(
  allWorks.filter((w) => w.slug && w.date).map((w) => [w.slug, w.date]),
)

const imageBySlug = Object.fromEntries(
  allWorks.filter((w) => w.slug && w.image).map((w) => [w.slug, w.image]),
)

/**
 * Small pre-generated thumbnails live in /images/thumbs/<slug>.jpg so the
 * table doesn't load full-size images to render 44x32 thumbs.
 */
const thumbSrc = (slug) => `/images/thumbs/${slug}.jpg`

/**
 * Split a section's groups into selected (has a page, featured) and unselected
 * rows, keeping group titles. An item can have a `slug` (and be clickable)
 * without being "selected" yet — mark it `unlisted: true` to keep it in the
 * Archive table while still linking to its page.
 */
function splitSection(section) {
  const selected = []
  const unselected = []
  for (const group of section.groups) {
    for (const item of group.items) {
      if (item.hidden) continue
      const row = { item, groupTitle: group.title }
      if (item.slug && !item.unlisted) selected.push(row)
      else unselected.push(row)
    }
  }
  const rowDate = ({ item }) => (item.slug ? dateBySlug[item.slug] : undefined) ?? item.date
  const byYearDesc = (a, b) => (rowDate(b) ?? "0000").localeCompare(rowDate(a) ?? "0000")
  selected.sort(byYearDesc)
  unselected.sort(byYearDesc)
  return { selected, unselected }
}
---

<Layout title="Work — Wasawat Somno" description="Index of works">
  <div class="relative z-10 font-mono p-8 pb-20 w-full">
    <p class="text-[12px] uppercase tracking-widest mb-2" style="color: var(--text-dim);">[work]</p>
    <h1 class="font-bold text-3xl lg:text-4xl mb-10" style="color: var(--text);">Work</h1>

    {
      artSections.map((section) => {
        const { selected, unselected } = splitSection(section)
        return (
          <section class="mb-14">
            <h2 class="font-bold text-xl mb-4 uppercase tracking-wide" style="color: var(--text);">{section.title}</h2>

            {selected.length > 0 && (
              <>
                <p class="text-[11px] uppercase tracking-widest mb-2" style="color: var(--text-dim);">Selected</p>
                <div class="neu-panel mb-8">
                <table class="work-table w-full text-[13px] border-collapse">
                  <colgroup>
                    <col style="width: 56px;" />
                    <col />
                    <col style="width: 180px;" />
                    <col style="width: 60px;" />
                  </colgroup>
                  <thead>
                    <tr>
                      <th class="text-left font-normal py-2 pr-4"></th>
                      <th class="text-left font-normal uppercase tracking-widest py-2 pr-4" style="color: var(--text-dim); font-size: 11px;">Title</th>
                      <th class="text-left font-normal uppercase tracking-widest py-2 pr-4" style="color: var(--text-dim); font-size: 11px;">Medium</th>
                      <th class="text-right font-normal uppercase tracking-widest py-2" style="color: var(--text-dim); font-size: 11px;">Year</th>
                    </tr>
                  </thead>
                  <tbody>
                    {selected.map(({ item, groupTitle }) => {
                      const date = dateBySlug[item.slug] ?? item.date
                      const image = imageBySlug[item.slug] ?? item.image
                      return (
                        <tr class="row-link" data-href={`/art/${item.slug}`}>
                          <td class="py-2 pr-4">
                            {image ? (
                              <div class="dither-thumb neu-thumb" style="width: 44px; height: 32px; flex-shrink: 0;">
                                <img
                                  src={thumbSrc(item.slug)}
                                  alt=""
                                  loading="lazy"
                                />
                              </div>
                            ) : (
                              <div class="neu-thumb" style="width: 44px; height: 32px;" />
                            )}
                          </td>
                          <td class="py-2 pr-4 work-piece-title" style="color: var(--text-muted);">
                            <a href={`/art/${item.slug}`} class="hover:underline">
                              {item.label}
                            </a>
                          </td>
                          <td class="py-2 pr-4" style="color: var(--text-dim);">
                            {groupTitle ?? "—"}
                          </td>
                          <td class="py-2 text-right" style="color: var(--text-dim);">
                            {date ? date.slice(0, 4) : "—"}
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
                </div>
              </>
            )}

            {unselected.length > 0 && (
              <>
                <p class="text-[11px] uppercase tracking-widest mb-2" style="color: var(--text-dim);">Archive</p>
                <div class="neu-panel">
                <table class="work-table w-full text-[13px] border-collapse">
                  <colgroup>
                    <col style="width: 56px;" />
                    <col />
                    <col style="width: 180px;" />
                    <col style="width: 60px;" />
                  </colgroup>
                  <tbody>
                    {unselected.map(({ item, groupTitle }) => {
                      const archiveDate = (item.slug ? dateBySlug[item.slug] : undefined) ?? item.date
                      const archiveImage = (item.slug ? imageBySlug[item.slug] : undefined) ?? item.image
                      const href = item.slug ? `/art/${item.slug}` : item.url
                      return (
                        <tr
                          class={href ? "row-link" : undefined}
                          data-href={href || undefined}
                          data-external={!item.slug && item.url ? "true" : undefined}
                        >
                          <td class="py-2 pr-4">
                            {archiveImage ? (
                              <div class="dither-thumb neu-thumb" style="width: 44px; height: 32px; flex-shrink: 0;">
                                <img
                                  src={thumbSrc(item.slug)}
                                  alt=""
                                  loading="lazy"
                                />
                              </div>
                            ) : (
                              <div class="neu-thumb" style="width: 44px; height: 32px;" />
                            )}
                          </td>
                          <td class="py-2 pr-4 work-piece-title" style="color: var(--text-muted);">
                            {item.slug ? (
                              <a href={`/art/${item.slug}`} class="hover:underline">
                                {item.label}
                              </a>
                            ) : item.url ? (
                              <a href={item.url} target="_blank" rel="noopener noreferrer" class="hover:underline">
                                {item.label}
                              </a>
                            ) : (
                              item.label
                            )}
                          </td>
                          <td class="py-2 pr-4" style="color: var(--text-dim);">
                            {groupTitle ?? "—"}
                          </td>
                          <td class="py-2 text-right" style="color: var(--text-dim);">
                            {archiveDate ? archiveDate.slice(0, 4) : "—"}
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
                </div>
              </>
            )}
          </section>
        )
      })
    }
  </div>
</Layout>

<style>
  .neu-panel {
    --neu-bg: var(--bg-elevated, #f5f5f5);
    --neu-light: #ffffff;
    --neu-dark: #dcdce0;
    background: var(--neu-bg);
    border-radius: 12px;
    padding: 4px 16px;
    box-shadow:
      3px 3px 6px var(--neu-dark),
      -3px -3px 6px var(--neu-light);
  }

  .work-table {
    table-layout: fixed;
  }
  .work-table th,
  .work-table td {
    overflow-wrap: anywhere;
  }
  .work-table thead tr {
    box-shadow: inset 0 -1px 0 var(--neu-dark, #d1d1d6);
  }
  .work-table tbody tr {
    transition: background 0.15s ease;
    border-radius: 10px;
  }
  .work-table tbody tr:not(:last-child) {
    box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.05);
  }
  .work-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.35);
  }
  .work-table tbody tr.row-link {
    cursor: pointer;
  }
  .work-piece-title {
    font-family: "DepartureMono", monospace;
    font-size: 13px;
    letter-spacing: 0.03em;
  }
  .neu-thumb {
    border-radius: 5px;
    background: var(--neu-bg, #f5f5f5);
    box-shadow:
      1.5px 1.5px 3px var(--neu-dark, #dcdce0),
      -1.5px -1.5px 3px var(--neu-light, #ffffff);
    overflow: hidden;
  }
</style>

<script>
  // Clicking anywhere in a "row-link" row navigates like clicking its title
  // link, except when the click is on an actual <a> (let that handle itself).
  document.querySelectorAll(".work-table tbody tr.row-link").forEach((row) => {
    const href = row.dataset.href
    if (!href) return
    row.addEventListener("click", (e) => {
      if (e.target instanceof Element && e.target.closest("a")) return
      if (row.dataset.external === "true") {
        window.open(href, "_blank", "noopener")
      } else {
        window.location.href = href
      }
    })
  })
</script>
