---
import Layout from "../layouts/layout.astro"
import NewsEntry from "../components/news/NewsEntry.astro"
import { splitNews } from "../data/news.js"

// The page is server-rendered, so an event moves itself into the archive the
// day after it ends — no edit needed. Add entries in src/data/news.js.
const { upcoming, archive } = splitNews()
---

<Layout title="News — Wasawat Somno" description="Upcoming events and news">
  <div class="relative z-10 font-mono w-full mt-16 pb-24 px-8 lg:w-4/5 max-w-3xl">

    <p class="uppercase text-[13px] tracking-widest mb-10 font-normal" style="color: var(--text-muted)">
      ~News
    </p>

    {upcoming.length === 0 && (
      <p class="news-empty">Nothing scheduled at the moment — past events are in the archive below.</p>
    )}

    {upcoming.map((entry, i) => (
      <NewsEntry entry={entry} last={archive.length === 0 && i === upcoming.length - 1} />
    ))}

    {archive.length > 0 && (
      <details class="news-archive">
        <summary>
          <span class="news-archive-label">~Archive</span>
          <span class="news-archive-count">{archive.length} past {archive.length === 1 ? "event" : "events"}</span>
        </summary>
        <div class="news-archive-list">
          {archive.map((entry, i) => (
            <NewsEntry entry={entry} past last={i === archive.length - 1} />
          ))}
        </div>
      </details>
    )}

  </div>
</Layout>

<style>
  .news-empty {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 3rem;
  }

  .news-archive summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--text-muted);
  }
  .news-archive summary::-webkit-details-marker {
    display: none;
  }
  .news-archive summary:hover {
    color: var(--text-body);
  }
  .news-archive summary::after {
    content: "[+]";
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  .news-archive[open] summary::after {
    content: "[–]";
  }
  .news-archive-label {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .news-archive-count {
    font-size: 11px;
    opacity: 0.7;
  }
  .news-archive-list {
    margin-top: 2.5rem;
  }
</style>
