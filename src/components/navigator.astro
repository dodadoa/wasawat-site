---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/"
const pathSuffix = pathname === "/" ? "" : pathname
---

<nav
  class="fixed z-[100] top-0 w-full font-normal bg-white pointer-events-auto"
  style="border-bottom: 1px solid var(--border-subtle); font-family: 'JetBrains Mono', monospace;"
  id="site-nav"
>
  <div class="flex flex-row items-center justify-between h-10 w-full">
    <div class="p-2 pl-4 sm:pl-6 bg-white flex items-center">
      <a
        href="/"
        class="nav-brand hover:no-underline uppercase"
        style="color: var(--text)"
      >
        ~/giang
        {pathSuffix && (
          <span id="nav-path-suffix" style="color: #2a2a2a">{pathSuffix}</span>
        )}
      </a>
    </div>

    <button
      type="button"
      id="nav-menu-toggle"
      class="lg:hidden flex items-center justify-center w-10 h-10 mr-1 cursor-pointer bg-transparent border-0 p-0"
      style="color: var(--text)"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-mobile-panel"
    >
      <svg id="nav-icon-open" width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="1.5" />
      </svg>
      <svg id="nav-icon-close" class="hidden" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>

    <div class="lg:flex lg:flex-row lg:items-center lg:justify-between lg:mr-6 hidden">
      <a href="/news" class="nav-desktop-link nav-link-news">
        <span class="mx-4">/news</span>
      </a>
      <a href="/index" class="nav-desktop-link nav-link-index">
        <span class="mx-4">/index</span>
      </a>
      <a href="/about" class="nav-desktop-link nav-link-about">
        <span class="mx-4">/about</span>
      </a>
    </div>
  </div>

  <div
    id="nav-mobile-panel"
    class="lg:hidden hidden w-full bg-white"
    style="border-top: 1px solid var(--border-subtle);"
  >
    <div class="flex flex-col px-6 py-4 gap-4">
      <a href="/news" class="nav-mobile-link nav-link-news">
        /news
      </a>
      <a href="/index" class="nav-mobile-link nav-link-index">
        /index
      </a>
      <a href="/about" class="nav-mobile-link nav-link-about">
        /about
      </a>
    </div>
  </div>
</nav>

<style>
  .nav-brand {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .nav-desktop-link,
  .nav-mobile-link {
    color: var(--text-muted);
    text-decoration: none;
    text-transform: uppercase;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .nav-desktop-link {
    display: flex;
    flex-direction: column;
    align-items: middle;
  }

  .nav-mobile-link {
    font-size: 11px;
    letter-spacing: 0.03em;
  }

  .nav-link-news:hover {
    color: #2a7a5a;
  }

  .nav-link-index:hover {
    color: #4f4fbf;
  }

  .nav-link-about:hover {
    color: #9a3a8f;
  }

  @media (min-width: 1024px) {
    .nav-brand {
      font-size: 12px;
      letter-spacing: 0.06em;
    }

    .nav-desktop-link {
      font-size: 12px;
      letter-spacing: 0.06em;
    }
  }
</style>

<script>
  function readPathSuffix() {
    const pathname = window.location.pathname.replace(/\/$/, "") || "/"
    return pathname === "/" ? "" : pathname
  }

  function updatePathSuffix() {
    const suffix = readPathSuffix()
    let el = document.getElementById("nav-path-suffix")
    const link = document.querySelector("#site-nav > div:first-child > div:first-child > a")

    if (suffix && !el && link) {
      el = document.createElement("span")
      el.id = "nav-path-suffix"
      el.style.color = "#2a2a2a"
      link.appendChild(el)
    }

    if (el) {
      if (suffix) {
        el.textContent = suffix
        el.style.display = ""
      } else {
        el.remove()
      }
    }
  }

  function setMenuOpen(open) {
    const panel = document.getElementById("nav-mobile-panel")
    const toggle = document.getElementById("nav-menu-toggle")
    const iconOpen = document.getElementById("nav-icon-open")
    const iconClose = document.getElementById("nav-icon-close")
    if (!panel || !toggle) return

    panel.classList.toggle("hidden", !open)
    toggle.setAttribute("aria-expanded", open ? "true" : "false")
    iconOpen?.classList.toggle("hidden", open)
    iconClose?.classList.toggle("hidden", !open)
  }

  function setupNav() {
    const toggle = document.getElementById("nav-menu-toggle")
    if (!toggle || toggle.dataset.bound === "1") {
      updatePathSuffix()
      return
    }
    toggle.dataset.bound = "1"

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true"
      setMenuOpen(!open)
    })

    document.getElementById("nav-mobile-panel")?.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => setMenuOpen(false))
    })

    updatePathSuffix()
    window.addEventListener("popstate", updatePathSuffix)
  }

  setupNav()
  document.addEventListener("astro:page-load", setupNav)
</script>
