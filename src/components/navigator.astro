---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/"
// /cv isn't a nested route, but conceptually it lives under /about — show
// it that way in the breadcrumb rather than as a flat top-level page
const displayPath = pathname === "/cv" ? "/about/cv" : pathname
const pathSuffix = pathname === "/" ? "" : displayPath

const links = [
  { href: "/news", label: "/news", cls: "nav-link-news" },
  { href: "/work", label: "/work", cls: "nav-link-index" },
  { href: "/about", label: "/about", cls: "nav-link-about" },
]
// /art/* lives under /work, /cv and /resume under /about
const section =
  pathname.startsWith("/art") || pathname.startsWith("/work") ? "/work"
  : pathname === "/cv" || pathname === "/resume" || pathname.startsWith("/about") ? "/about"
  : pathname.startsWith("/news") ? "/news"
  : ""
---

<nav class="fixed z-[100] top-0 w-full font-normal pointer-events-auto" id="site-nav">
  <div class="flex flex-row items-stretch justify-between h-10 w-full">
    <div class="pl-4 sm:pl-6 flex items-center">
      <a href="/" class="nav-brand hover:no-underline uppercase">
        ~/giang
        {pathSuffix && (
          <span id="nav-path-suffix">{pathSuffix}</span>
        )}
      </a>
    </div>

    <button
      type="button"
      id="nav-menu-toggle"
      class="lg:hidden flex items-center justify-center w-10 h-10 cursor-pointer bg-transparent border-0 p-0"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-mobile-panel"
    >
      <svg id="nav-icon-open" width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true" shape-rendering="crispEdges">
        <path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="1" />
      </svg>
      <svg id="nav-icon-close" class="hidden" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1" />
      </svg>
    </button>

    <div class="nav-desktop lg:flex lg:flex-row lg:items-stretch hidden">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={["nav-desktop-link", l.cls]}
          aria-current={section === l.href ? "page" : undefined}
        >
          {l.label}
        </a>
      ))}
    </div>
  </div>

  <div id="nav-mobile-panel" class="lg:hidden hidden w-full">
    <div class="flex flex-col">
      {links.map((l, i) => (
        <a
          href={l.href}
          class:list={["nav-mobile-link", l.cls]}
          aria-current={section === l.href ? "page" : undefined}
        >
          <span class="nav-mobile-count">{String(i + 1).padStart(2, "0")} →</span>
          {l.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  /* small pixel-font chrome: a strip of cells that share borders */
  #site-nav {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    font-family: var(--f-pixel);
    color: var(--ink);
  }

  .nav-brand {
    font-family: var(--f-pixel);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--ink);
  }

  .nav-brand :global(#nav-path-suffix) {
    color: var(--soft);
  }

  #nav-menu-toggle {
    color: var(--ink);
    border-left: 1px solid var(--line);
  }

  #nav-menu-toggle[aria-expanded="true"] {
    background: var(--ink);
    color: var(--bg);
  }

  .nav-desktop-link,
  .nav-mobile-link {
    color: var(--ink);
    text-decoration: none;
    text-transform: uppercase;
    font-family: var(--f-pixel);
    font-size: 12px;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .nav-desktop-link {
    display: flex;
    align-items: center;
    padding: 0 1.4rem;
    border-left: 1px solid var(--line);
  }

  /* hover and the current section are a full inversion */
  .nav-desktop-link:hover,
  .nav-desktop-link[aria-current="page"],
  .nav-mobile-link:hover,
  .nav-mobile-link[aria-current="page"] {
    background: var(--ink);
    color: var(--bg);
  }

  #nav-mobile-panel {
    background: var(--bg);
    border-top: 1px solid var(--line);
  }

  .nav-mobile-link {
    display: flex;
    gap: 1rem;
    padding: 0.9rem 1.5rem;
    border-top: 1px solid var(--line);
  }

  .nav-mobile-link:first-child {
    border-top: 0;
  }

  .nav-mobile-count {
    color: var(--soft);
  }

  .nav-mobile-link:hover .nav-mobile-count,
  .nav-mobile-link[aria-current="page"] .nav-mobile-count {
    color: var(--bg);
  }
</style>

<script>
  function readPathSuffix() {
    const pathname = window.location.pathname.replace(/\/$/, "") || "/"
    const displayPath = pathname === "/cv" ? "/about/cv" : pathname
    return pathname === "/" ? "" : displayPath
  }

  function updatePathSuffix() {
    const suffix = readPathSuffix()
    let el = document.getElementById("nav-path-suffix")
    const link = document.querySelector("#site-nav > div:first-child > div:first-child > a")

    if (suffix && !el && link) {
      el = document.createElement("span")
      el.id = "nav-path-suffix"
      link.appendChild(el)
    }

    if (el) {
      if (suffix) {
        el.textContent = suffix
        el.style.display = ""
      } else {
        el.remove()
      }
    }
  }

  function setMenuOpen(open) {
    const panel = document.getElementById("nav-mobile-panel")
    const toggle = document.getElementById("nav-menu-toggle")
    const iconOpen = document.getElementById("nav-icon-open")
    const iconClose = document.getElementById("nav-icon-close")
    if (!panel || !toggle) return

    panel.classList.toggle("hidden", !open)
    toggle.setAttribute("aria-expanded", open ? "true" : "false")
    iconOpen?.classList.toggle("hidden", open)
    iconClose?.classList.toggle("hidden", !open)
  }

  // the desktop cells are as wide as their labels; publish that width so a
  // page's own right-hand column (the roguelike index) can share the nav's rule
  function publishDesktopWidth() {
    const desktop = document.querySelector("#site-nav .nav-desktop")
    const w = desktop ? desktop.getBoundingClientRect().width : 0
    const root = document.documentElement
    if (w > 0) root.style.setProperty("--nav-desktop-w", `${w}px`)
    else root.style.removeProperty("--nav-desktop-w")
  }

  function setupNav() {
    publishDesktopWidth()
    const toggle = document.getElementById("nav-menu-toggle")
    if (!toggle || toggle.dataset.bound === "1") {
      updatePathSuffix()
      return
    }
    toggle.dataset.bound = "1"

    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") === "true"
      setMenuOpen(!open)
    })

    document.getElementById("nav-mobile-panel")?.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => setMenuOpen(false))
    })

    updatePathSuffix()
    window.addEventListener("popstate", updatePathSuffix)
    window.addEventListener("resize", publishDesktopWidth)
    document.fonts?.ready.then(publishDesktopWidth)
  }

  setupNav()
  document.addEventListener("astro:page-load", setupNav)
</script>
