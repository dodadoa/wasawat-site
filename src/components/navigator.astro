---
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/"
const pathSuffix = pathname === "/" ? "" : pathname
---

<nav
  class="fixed z-[100] top-0 flex flex-row justify-between h-10 w-full font-normal bg-white pointer-events-auto"
  style="border-bottom: 1px solid var(--border-subtle); font-family: 'JetBrains Mono', monospace;"
  id="site-nav"
>
  <div class="p-2 pl-6 bg-white flex items-center">
    <a
      href="/"
      class="hover:no-underline text-[13px] tracking-widest uppercase"
      style="color: var(--text)"
    >
      ~/giang
      {pathSuffix && (
        <span id="nav-path-suffix" style="color: #2a2a2a">{pathSuffix}</span>
      )}
    </a>
  </div>

  <div class="lg:hidden">
    <button
      type="button"
      id="nav-menu-open"
      class="py-3 px-3 w-10 break-all leading-[6px] cursor-pointer uppercase text-[13px] bg-transparent border-0"
      style="color: var(--text-muted)"
      aria-label="Open menu"
    >
      menu
    </button>
  </div>

  <div id="nav-mobile-panel" class="lg:hidden hidden">
    <button
      type="button"
      id="nav-menu-close"
      class="absolute top-0 right-0 p-2 py-4 w-10 h-10 z-10 cursor-pointer text-[13px] uppercase bg-transparent border-0"
      style="color: var(--text-muted)"
      aria-label="Close menu"
    >
      x
    </button>
    <div
      class="absolute top-10 w-full bg-white flex flex-col p-4 gap-3"
      style="border-bottom: 1px solid var(--border)"
    >
      <a href="/index">
        <span class="uppercase text-[13px] tracking-widest" style="color: var(--text-muted)">
          /index
        </span>
      </a>
      <a href="/about">
        <span class="uppercase text-[13px] tracking-widest" style="color: var(--text-muted)">
          /about
        </span>
      </a>
    </div>
  </div>

  <div class="lg:flex lg:flex-row lg:items-center lg:justify-between lg:mr-6 hidden">
    <a href="/index" class="nav-desktop-link nav-link-index">
      <span class="mx-4">/index</span>
    </a>
    <a href="/about" class="nav-desktop-link nav-link-about">
      <span class="mx-4">/about</span>
    </a>
  </div>
</nav>

<style>
  .nav-desktop-link {
    color: var(--text-muted);
    text-decoration: none;
    text-transform: uppercase;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    letter-spacing: 0.1em;
    display: flex;
    flex-direction: column;
    align-items: middle;
    cursor: pointer;
  }

  .nav-link-index:hover {
    color: #4f4fbf;
  }

  .nav-link-about:hover {
    color: #9a3a8f;
  }
</style>

<script>
  function readPathSuffix() {
    const pathname = window.location.pathname.replace(/\/$/, "") || "/"
    return pathname === "/" ? "" : pathname
  }

  function updatePathSuffix() {
    const suffix = readPathSuffix()
    let el = document.getElementById("nav-path-suffix")
    const link = document.querySelector("#site-nav > div:first-child > a")

    if (suffix && !el && link) {
      el = document.createElement("span")
      el.id = "nav-path-suffix"
      el.style.color = "#2a2a2a"
      link.appendChild(el)
    }

    if (el) {
      if (suffix) {
        el.textContent = suffix
        el.style.display = ""
      } else {
        el.remove()
      }
    }
  }

  function setupNav() {
    const openBtn = document.getElementById("nav-menu-open")
    const closeBtn = document.getElementById("nav-menu-close")
    const panel = document.getElementById("nav-mobile-panel")

    openBtn?.addEventListener("click", () => panel?.classList.remove("hidden"))
    closeBtn?.addEventListener("click", () => panel?.classList.add("hidden"))

    updatePathSuffix()
    window.addEventListener("popstate", updatePathSuffix)
  }

  setupNav()
  document.addEventListener("astro:page-load", setupNav)
</script>
