---
export interface MetaField {
  label: string
  value?: string | null
  html?: boolean
}

interface Props {
  fields: MetaField[]
}

const { fields } = Astro.props
const visible = fields.filter((f) => f.value)
---

{visible.length > 0 && (
  <dl class="art-meta mb-6">
    {visible.map((f) => (
      <div class="art-meta-row">
        <dt>{f.label}</dt>
        {f.html
          ? <dd set:html={f.value} />
          : <dd>{f.value}</dd>
        }
      </div>
    ))}
  </dl>
)}

<style is:global>
  /* spec sheet: pixel-font labels against data-mono values, one ruled row each */
  .art-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0;
    line-height: 1.6;
    border-bottom: 1px solid var(--line);
    margin-bottom: 2.4rem;
    max-width: 64ch;
  }

  .art-meta-row {
    display: contents;
  }

  .art-meta dt,
  .art-meta dd {
    border-top: 1px solid var(--line);
    padding: 0.6rem 0;
  }

  .art-meta dt {
    padding-right: 2.5rem;
    font-family: var(--f-pixel);
    color: var(--soft);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 11px;
    line-height: 1.9;
  }

  .art-meta dd {
    font-family: var(--f-data);
    font-size: 14px;
    color: var(--ink);
    margin: 0;
  }

  .art-meta dd a {
    color: var(--ink);
    font-weight: normal;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
