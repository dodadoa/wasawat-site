---
/**
 * One news item. Shared by the upcoming list and the archive on /news —
 * `past` sets it smaller and in the dimmed ink; `index` is its row counter.
 */
import { formatRange } from "../../data/news.js"

const { entry, past = false, index } = Astro.props
---

<article class:list={["news-entry", past && "news-entry--past"]}>
  <div class="news-date">
    {index && <span class="news-count">{String(index).padStart(2, "0")} →</span>}
    <span>{formatRange(entry.start, entry.end)}</span>
  </div>
  <div class="news-body">
    {entry.venue && (
      <p class="news-venue">
        {entry.venue.map((v, i) => (
          <>
            {i > 0 && <span> · </span>}
            {v.href ? (
              <a href={v.href} target="_blank" rel="noopener noreferrer">{v.label}</a>
            ) : (
              <span>{v.label}</span>
            )}
          </>
        ))}
        {entry.venueSuffix && <span> · {entry.venueSuffix}</span>}
      </p>
    )}

    <h2 class="news-title">{entry.title}</h2>
    {entry.subtitle && <p class="news-subtitle">{entry.subtitle}</p>}

    {entry.body?.map((paragraph, i) => (
      <p class="news-desc" style={i > 0 ? "margin-top: 0.5rem;" : undefined} set:html={paragraph} />
    ))}

    {entry.meta && (
      <div class="news-meta">
        {entry.meta.map((line) => <div set:html={line} />)}
      </div>
    )}

    {entry.links && (
      <div class="news-links">
        {entry.links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  /* each item is ruled off on top, with generous air above and below */
  .news-entry {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 0 3rem;
    padding: 2.6rem 0 3.2rem;
    border-top: 1px solid var(--line);
  }
  .news-date {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--f-data);
    font-size: 14px;
    line-height: 1.6;
    color: var(--soft);
  }
  .news-count {
    font-family: var(--f-pixel);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
  .news-venue {
    font-family: var(--f-pixel);
    font-size: 12px;
    text-transform: uppercase;
    color: var(--soft);
    letter-spacing: 0.08em;
    line-height: 1.5;
    margin-bottom: 0.9rem;
  }
  .news-venue a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .news-venue a:hover {
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
  }
  .news-title {
    font-size: 44px;
    margin-bottom: 0.8rem;
  }
  .news-subtitle {
    font-family: var(--f-body);
    font-size: 24px;
    line-height: 1.28;
    color: var(--ink);
    margin-bottom: 1.2rem;
    font-style: italic;
  }
  .news-desc {
    font-family: var(--f-body);
    font-size: 18px;
    line-height: 1.45;
    color: var(--ink);
    max-width: 60ch;
  }
  .news-desc :global(a) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .news-meta {
    margin-top: 1.4rem;
    font-family: var(--f-data);
    font-size: 13px;
    color: var(--soft);
    line-height: 1.6;
  }
  .news-links {
    display: flex;
    flex-wrap: wrap;
    margin-top: 1.6rem;
  }
  /* a strip of bordered cells that share borders; hover inverts */
  .news-links a {
    font-family: var(--f-pixel);
    font-size: 12px;
    color: var(--ink);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1;
    border: 1px solid var(--ink);
    padding: 0.75em 1em;
    margin: 0 -1px -1px 0;
  }
  .news-links a::after {
    content: " →";
  }
  .news-links a:hover {
    background: var(--ink);
    color: var(--bg);
  }

  /* Past entries sit quieter than what's coming up: smaller, in dimmed ink. */
  .news-entry--past {
    padding: 1.8rem 0 2.2rem;
  }
  .news-entry--past .news-title {
    font-size: 28px;
    color: var(--soft);
  }
  .news-entry--past .news-count,
  .news-entry--past .news-subtitle,
  .news-entry--past .news-desc {
    color: var(--soft);
  }
  .news-entry--past .news-subtitle {
    font-size: 18px;
  }
  .news-entry--past .news-desc {
    font-size: 16px;
  }
  .news-entry--past:hover .news-title,
  .news-entry--past:hover .news-count,
  .news-entry--past:hover .news-subtitle,
  .news-entry--past:hover .news-desc {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .news-entry {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .news-date {
      flex-direction: row;
      gap: 1rem;
    }
    .news-title {
      font-size: 32px;
    }
    .news-entry--past .news-title {
      font-size: 24px;
    }
  }
</style>
