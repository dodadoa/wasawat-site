---
import Layout from "./layout.astro"

const { frontmatter } = Astro.props
---

<Layout
  title={frontmatter.title}
  preview={frontmatter.preview}
  description={frontmatter.description}
>
  <div class="blog-post">
    <h1 class="wipe">{frontmatter.title}</h1>
    <p class="lead wipe">{frontmatter.description}</p>
    <div class="blog-post-body wipe">
      <slot />
    </div>
  </div>
</Layout>

<style is:global>
  .blog-post {
    padding: 2rem 2rem 6rem;
    max-width: 1080px;
  }

  .blog-post > h1 {
    font-size: clamp(34px, 5.2vw, 76px);
    margin: 2.5rem 0 2rem;
    filter: url(#ink-body);
  }

  .blog-post-body {
    margin-top: 3rem;
    max-width: 64ch;
    font-family: var(--f-body);
    font-size: 18px;
    line-height: 1.45;
  }

  .blog-post-body h1,
  .blog-post-body h2 {
    font-size: 44px;
    margin: 3rem 0 1rem;
    filter: url(#ink-small);
  }

  .blog-post-body h3 {
    margin: 2.4rem 0 0.8rem;
  }

  .blog-post-body p {
    margin-bottom: 1.1em;
  }

  .blog-post-body ul,
  .blog-post-body ol {
    list-style: none;
    padding: 0;
    counter-reset: step;
  }

  .blog-post-body li {
    position: relative;
    margin: 0;
    padding: 0.55em 0 0.55em 3.2em;
    border-top: 1px solid var(--line);
    counter-increment: step;
  }

  .blog-post-body li::before {
    position: absolute;
    left: 0;
    top: 0.75em;
    font-family: var(--f-pixel);
    font-size: 12px;
    color: var(--soft);
    content: "→";
  }

  .blog-post-body ol > li::before {
    content: counter(step, decimal-leading-zero);
  }

  .blog-post-body a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blog-post-body a:hover {
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
  }
</style>
