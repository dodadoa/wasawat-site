---
import { SEO } from "astro-seo"
import Navigator from "../components/navigator.astro"
import { artSections } from "../data/artArchive.js"

export interface Props {
  title?: string
  preview?: string
  description?: string
  /** @deprecated the whole site is 1-bit now; kept so existing callers still type-check */
  mono?: boolean
}

const { title, preview, description, mono = false } = Astro.props

// ── right-click sitemap tree ──
// Built once at build time from the same artSections data that drives
// /index, so the context menu's subtree never drifts from the real archive.
/** @typedef {{ label: string, path?: string, children?: SitemapNode[] }} SitemapNode */

/** @param {import('../data/artArchive.js').ArtSection[]} sections @returns {SitemapNode[]} */
function buildIndexSubtree(sections) {
  return sections
    .map((section) => {
      const children = section.groups.flatMap((group) => {
        const items = group.items
          .filter((item) => item.slug && !item.hidden)
          .map((item) => ({ label: item.label, path: `/art/${item.slug}` }))
        if (items.length === 0) return []
        return group.title ? [{ label: group.title, children: items }] : items
      })
      return children.length ? { label: section.title, children } : null
    })
    .filter(Boolean)
}

/** @type {SitemapNode[]} */
const sitemapTree = [
  { label: "Home", path: "/" },
  { label: "News", path: "/news" },
  { label: "Work", path: "/work", children: buildIndexSubtree(artSections) },
  {
    label: "About",
    path: "/about",
    children: [
      { label: "CV", path: "/cv" },
      { label: "Resume", path: "/resume" },
    ],
  },
]
---

<!DOCTYPE html>
<html lang="en" data-mono={mono ? "" : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <style>
      @font-face {
        font-family: "403Mesapholic";
        src: url("/fonts/403 Mesapholic (Extended)/WEB/403Mesapholic-Regular.woff2") format("woff2"),
             url("/fonts/403 Mesapholic (Extended)/WEB/403Mesapholic-Regular.woff") format("woff");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "403Mesapholic";
        src: url("/fonts/403 Mesapholic (Extended)/WEB/403Mesapholic-Italic.woff2") format("woff2"),
             url("/fonts/403 Mesapholic (Extended)/WEB/403Mesapholic-Italic.woff") format("woff");
        font-weight: normal;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: "TimesNewerRoman";
        src: url("/fonts/TimesNewerRoman/TimesNewerRoman-Regular.otf") format("opentype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "TimesNewerRoman";
        src: url("/fonts/TimesNewerRoman/TimesNewerRoman-Bold.otf") format("opentype");
        font-weight: bold;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "TimesNewerRoman";
        src: url("/fonts/TimesNewerRoman/TimesNewerRoman-Italic.otf") format("opentype");
        font-weight: normal;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: "TimesNewerRoman";
        src: url("/fonts/TimesNewerRoman/TimesNewerRoman-BoldItalic.otf") format("opentype");
        font-weight: bold;
        font-style: italic;
        font-display: swap;
      }
      @font-face {
        font-family: "DepartureMono";
        src: url("/fonts/DepartureMono-Regular.woff2") format("woff2"),
             url("/fonts/DepartureMono-Regular.woff") format("woff");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
      }
    </style>
    <SEO
      title={title}
      description=""
      openGraph={{
        basic: {
          title: title || "",
          image: preview || "",
          type: "website",
        },
      }}
    />
    <title>{title}</title>
  </head>
  <body>
    <!-- ── ink-bleed filters: blur → warp by coarse noise → threshold the alpha
         back to a hard edge (slope 6, cut 0.42, so ink spreads a little) →
         fine grain → over a wide bloom (the strongest glow on the page). Blur ≈ half the stroke width,
         so there is one per text size. ── -->
    <svg class="ink-defs" width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <defs>
        <!-- line drawings: every pixel snaps to ink or nothing -->
        <filter id="one-bit" color-interpolation-filters="sRGB">
          <feComponentTransfer>
            <feFuncA type="discrete" tableValues="0 1 1 1 1 1 1 1" />
          </feComponentTransfer>
        </filter>
        <filter id="ink-title" x="-6%" y="-35%" width="112%" height="170%" color-interpolation-filters="sRGB">
          <feGaussianBlur in="SourceGraphic" stdDeviation="1.8" result="blur" />
          <feTurbulence type="fractalNoise" baseFrequency="0.022" numOctaves="2" seed="4" result="warp" />
          <feDisplacementMap in="blur" in2="warp" scale="3.2" xChannelSelector="R" yChannelSelector="G" result="warped" />
          <feComponentTransfer in="warped" result="hard">
            <feFuncA type="linear" slope="6" intercept="-2.02" />
          </feComponentTransfer>
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="1" seed="11" result="grain" />
          <feDisplacementMap in="hard" in2="grain" scale="1.6" xChannelSelector="R" yChannelSelector="G" result="ink" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="7" result="wide" />
          <feComponentTransfer in="wide" result="bloom">
            <feFuncA type="linear" slope="0.45" />
          </feComponentTransfer>
          <feMerge><feMergeNode in="bloom" /><feMergeNode in="ink" /></feMerge>
        </filter>
        <filter id="ink-body" x="-6%" y="-40%" width="112%" height="180%" color-interpolation-filters="sRGB">
          <feGaussianBlur in="SourceGraphic" stdDeviation="1.15" result="blur" />
          <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="warp" />
          <feDisplacementMap in="blur" in2="warp" scale="3" xChannelSelector="R" yChannelSelector="G" result="warped" />
          <feComponentTransfer in="warped" result="hard">
            <feFuncA type="linear" slope="6" intercept="-2.02" />
          </feComponentTransfer>
          <feTurbulence type="fractalNoise" baseFrequency="0.95" numOctaves="1" seed="13" result="grain" />
          <feDisplacementMap in="hard" in2="grain" scale="1.5" xChannelSelector="R" yChannelSelector="G" result="ink" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="4.5" result="wide" />
          <feComponentTransfer in="wide" result="bloom">
            <feFuncA type="linear" slope="0.42" />
          </feComponentTransfer>
          <feMerge><feMergeNode in="bloom" /><feMergeNode in="ink" /></feMerge>
        </filter>
        <filter id="ink-small" x="-6%" y="-45%" width="112%" height="190%" color-interpolation-filters="sRGB">
          <feGaussianBlur in="SourceGraphic" stdDeviation="0.6" result="blur" />
          <feTurbulence type="fractalNoise" baseFrequency="0.06" numOctaves="2" seed="9" result="warp" />
          <feDisplacementMap in="blur" in2="warp" scale="1.6" xChannelSelector="R" yChannelSelector="G" result="warped" />
          <feComponentTransfer in="warped" result="hard">
            <feFuncA type="linear" slope="6" intercept="-2.02" />
          </feComponentTransfer>
          <feTurbulence type="fractalNoise" baseFrequency="1.1" numOctaves="1" seed="17" result="grain" />
          <feDisplacementMap in="hard" in2="grain" scale="0.8" xChannelSelector="R" yChannelSelector="G" result="ink" />
          <feGaussianBlur in="SourceGraphic" stdDeviation="3" result="wide" />
          <feComponentTransfer in="wide" result="bloom">
            <feFuncA type="linear" slope="0.4" />
          </feComponentTransfer>
          <feMerge><feMergeNode in="bloom" /><feMergeNode in="ink" /></feMerge>
        </filter>
      </defs>
    </svg>
    <div id="site-loader" role="status" aria-live="polite" aria-label="Loading">

      <!-- ── 4-quadrant political compass loader ── -->
      <!-- Animated dither rects fill each quadrant; axes + dots render on top -->
      <!-- CX=500 CY=350 AX=270; quadrants: TL[230-500,80-350] TR[500-770,80-350] BL[230-500,350-620] BR[500-770,350-620] -->
      <div class="loader-compass-wrap">
        <svg class="loader-compass" viewBox="-280 -20 1560 740" aria-hidden="true">
          <defs>
            <!-- ordered dither patterns — 2px dots, increasing density per quadrant -->
            <!-- TL "Community Garden": very sparse, 1 dot per 16×16 ≈ 1.6% -->
            <pattern id="dTL" x="0" y="0" width="16" height="16" patternUnits="userSpaceOnUse">
              <rect x="0" y="0" width="3" height="3" fill="#0a0a0a"/>
            </pattern>
            <!-- TR "Maker Faire": light, 1 dot per 8×8 ≈ 14% -->
            <pattern id="dTR" x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse">
              <rect x="0" y="0" width="3" height="3" fill="#0a0a0a"/>
            </pattern>
            <!-- BL "Relational Despair": medium-heavy, 2×2 checkerboard per 8px ≈ 56% -->
            <pattern id="dBL" x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse">
              <rect x="0" y="0" width="4" height="4" fill="#0a0a0a"/>
              <rect x="4" y="4" width="4" height="4" fill="#0a0a0a"/>
            </pattern>
            <!-- BR "Accelerationism": dense, 3 of 4 cells filled ≈ 75% -->
            <pattern id="dBR" x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse">
              <rect x="0" y="0" width="4" height="4" fill="#0a0a0a"/>
              <rect x="4" y="4" width="4" height="4" fill="#0a0a0a"/>
              <rect x="0" y="4" width="4" height="4" fill="#0a0a0a"/>
            </pattern>
            <!-- clip paths — 1px inset so rects never cross the axis lines -->
            <clipPath id="cTL"><rect x="231" y="81" width="268" height="268"/></clipPath>
            <clipPath id="cTR"><rect x="501" y="81" width="268" height="268"/></clipPath>
            <clipPath id="cBL"><rect x="231" y="351" width="268" height="268"/></clipPath>
            <clipPath id="cBR"><rect x="501" y="351" width="268" height="268"/></clipPath>
          </defs>

          <!-- ── dither fills — one per quadrant, density tells the story; pulse cycles TL→TR→BR→BL ── -->
          <g class="loader-quad" clip-path="url(#cTL)" style="--qo: 0.3; --qd: 0s">
            <rect x="231" y="81" width="268" height="268" fill="url(#dTL)"/>
          </g>
          <g class="loader-quad" clip-path="url(#cTR)" style="--qo: 0.3; --qd: 0.4s">
            <rect x="501" y="81" width="268" height="268" fill="url(#dTR)"/>
          </g>
          <g class="loader-quad" clip-path="url(#cBR)" style="--qo: 0.34; --qd: 0.8s">
            <rect x="501" y="351" width="268" height="268" fill="url(#dBR)"/>
          </g>
          <g class="loader-quad" clip-path="url(#cBL)" style="--qo: 0.32; --qd: 1.2s">
            <rect x="231" y="351" width="268" height="268" fill="url(#dBL)"/>
          </g>

          <!-- ── main axes on top of rects ── -->
          <line x1="216" y1="350" x2="784" y2="350" stroke="#0a0a0a" stroke-width="0.9" opacity="0.6"/>
          <line x1="500" y1="66"  x2="500" y2="634" stroke="#0a0a0a" stroke-width="0.9" opacity="0.6"/>
          <!-- arrowheads -->
          <path d="M784,350 L774,345 L774,355 Z" fill="#0a0a0a" opacity="0.55"/>
          <path d="M216,350 L226,345 L226,355 Z" fill="#0a0a0a" opacity="0.55"/>
          <path d="M500,66  L495,76  L505,76  Z"  fill="#0a0a0a" opacity="0.55"/>
          <path d="M500,634 L495,624 L505,624 Z"  fill="#0a0a0a" opacity="0.55"/>
          <!-- tick marks -->
          <g stroke="#0a0a0a" stroke-width="0.8" opacity="0.4">
            <line x1="365" y1="344" x2="365" y2="356"/>  <line x1="635" y1="344" x2="635" y2="356"/>
            <line x1="230" y1="344" x2="230" y2="356"/>  <line x1="770" y1="344" x2="770" y2="356"/>
            <line x1="494" y1="215"  x2="506" y2="215"/>   <line x1="494" y1="485"  x2="506" y2="485"/>
            <line x1="494" y1="81"   x2="506" y2="81"/>    <line x1="494" y1="619"  x2="506" y2="619"/>
          </g>
          <!-- origin -->
          <circle cx="500" cy="350" r="5.5" fill="none" stroke="#0a0a0a" stroke-width="0.7" opacity="0.4"/>
          <circle cx="500" cy="350" r="1.8" fill="#0a0a0a" opacity="0.45"/>
          <!-- practice dots + rings (on top, still pulse) -->
          <circle class="loader-compass-mine" cx="586" cy="490" r="3.2" fill="#0a0a0a"/>
          <circle cx="586" cy="490" r="6.5" fill="none" stroke="#0a0a0a" stroke-width="0.7" opacity="0.3"/>
          <circle class="loader-compass-mine" cx="378" cy="453" r="3.2" fill="#0a0a0a" style="animation-delay:.38s"/>
          <circle cx="378" cy="453" r="6.5" fill="none" stroke="#0a0a0a" stroke-width="0.7" opacity="0.3"/>
          <circle class="loader-compass-mine" cx="360" cy="409" r="3.2" fill="#0a0a0a" style="animation-delay:.76s"/>
          <circle cx="360" cy="409" r="6.5" fill="none" stroke="#0a0a0a" stroke-width="0.7" opacity="0.3"/>
          <circle class="loader-compass-mine" cx="397" cy="237" r="3.2" fill="#0a0a0a" style="animation-delay:1.14s"/>
          <circle cx="397" cy="237" r="6.5" fill="none" stroke="#0a0a0a" stroke-width="0.7" opacity="0.3"/>
          <circle class="loader-compass-mine" cx="343" cy="183" r="3.2" fill="#0a0a0a" style="animation-delay:1.52s"/>
          <circle cx="343" cy="183" r="6.5" fill="none" stroke="#0a0a0a" stroke-width="0.7" opacity="0.3"/>
          <circle class="loader-compass-mine" cx="640" cy="220" r="3.2" fill="#0a0a0a" style="animation-delay:1.90s"/>
          <circle cx="640" cy="220" r="6.5" fill="none" stroke="#0a0a0a" stroke-width="0.7" opacity="0.3"/>
          <circle class="loader-compass-mine" cx="430" cy="507" r="3.2" fill="#0a0a0a" style="animation-delay:2.28s"/>
          <circle cx="430" cy="507" r="6.5" fill="none" stroke="#0a0a0a" stroke-width="0.7" opacity="0.3"/>
          <circle class="loader-compass-mine" cx="559" cy="156" r="3.2" fill="#0a0a0a" style="animation-delay:2.66s"/>
          <circle cx="559" cy="156" r="6.5" fill="none" stroke="#0a0a0a" stroke-width="0.7" opacity="0.3"/>
          <circle class="loader-compass-mine" cx="676" cy="237" r="3.2" fill="#0a0a0a" style="animation-delay:3.04s"/>
          <circle cx="676" cy="237" r="6.5" fill="none" stroke="#0a0a0a" stroke-width="0.7" opacity="0.3"/>
          <!-- context dots -->
          <circle cx="738" cy="588" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="700" cy="534" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="667" cy="139" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="619" cy="112" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="306" cy="210" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="316" cy="474" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="532" cy="323" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="333" cy="393" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="576" cy="285" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="748" cy="599" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="689" cy="183" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="279" cy="307" r="2" fill="#0a0a0a" opacity="0.28"/>
          <circle cx="414" cy="499" r="2" fill="#0a0a0a" opacity="0.28"/>
        </svg>
      </div>

      <p class="loader-label">loading · <span id="loader-pct">0</span>%</p>
      <!-- cycling doomsday dates — deadpan backdrop to BENATAR WAS RIGHT -->
      <p class="loader-ticker" id="loader-ticker" aria-hidden="true"></p>
    </div>

    <script>
      (function () {
        const loader = document.getElementById("site-loader")
        if (!loader) return

        const body = document.body
        const pctEl = document.getElementById("loader-pct")

        body.classList.add("is-loading")

        const tracked = new Set()
        let hidden = false
        let quietTimer = null
        let observer = null
        const maxTimer = setTimeout(finish, 7000)

        function setProgress(p) {
          const clamped = Math.max(0, Math.min(1, p))
          if (pctEl) pctEl.textContent = String(Math.round(clamped * 100))
        }

        // ── deadpan doomsday ticker: cycles through historical/predicted
        //    end-of-the-world dates while the actual page loads ──
        const DOOMSDAY_DATES = [
          "1844.10.22 — MILLERITE GREAT DISAPPOINTMENT",
          "1910.05.18 — HALLEY'S COMET PANIC",
          "1982.03.10 — THE JUPITER EFFECT",
          "1994.09.06 — CAMPING'S FIRST DATE",
          "1997.03.26 — HEAVEN'S GATE / HALE-BOPP",
          "1999.08.18 — GRAND CROSS ALIGNMENT",
          "2000.01.01 — Y2K ROLLOVER",
          "2003.05.15 — NIBIRU CATACLYSM (LIEDER)",
          "2011.05.21 — CAMPING'S JUDGMENT DAY",
          "2011.10.21 — CAMPING'S REVISED DATE",
          "2012.12.21 — MAYAN LONG COUNT",
          "2029.04.13 — APOPHIS CLOSE APPROACH",
        ]
        const tickerEl = document.getElementById("loader-ticker")
        let tickerIdx = 0
        let tickerTimer = null
        if (tickerEl) {
          const showNext = () => {
            tickerEl.textContent = DOOMSDAY_DATES[tickerIdx % DOOMSDAY_DATES.length]
            tickerIdx++
          }
          showNext()
          tickerTimer = setInterval(showNext, 2600)
        }

        /** @param {HTMLImageElement} img */
        function pending(img) {
          if (img.complete) return false
          // Below-the-fold lazy images never start fetching while the page
          // sits behind the loader (it can't be scrolled), so counting them
          // would wedge the progress at a partial percentage until the max
          // timeout. Only wait for lazy images actually in the viewport.
          if (img.loading === "lazy") {
            const r = img.getBoundingClientRect()
            const inView =
              r.bottom > 0 && r.top < window.innerHeight &&
              r.right > 0 && r.left < window.innerWidth
            if (!inView) return false
          }
          return true
        }

        function updateProgress() {
          if (tracked.size === 0) {
            setProgress(0.12)
            return
          }
          let pendingCount = 0
          tracked.forEach((img) => { if (pending(img)) pendingCount++ })
          const done = tracked.size - pendingCount
          // cap below 100% until the settle check actually finishes, so the
          // liquid never visually tops out before the overlay is gone
          setProgress(Math.min(0.96, done / tracked.size))
        }

        /** @param {HTMLImageElement} img */
        function trackImage(img) {
          if (tracked.has(img)) return
          tracked.add(img)
          if (pending(img)) {
            const onSettle = () => {
              img.removeEventListener("load", onSettle)
              img.removeEventListener("error", onSettle)
              updateProgress()
              scheduleSettleCheck()
            }
            img.addEventListener("load", onSettle)
            img.addEventListener("error", onSettle)
          }
        }

        function scanImages() {
          document.querySelectorAll("img").forEach(trackImage)
        }

        // Waits for a quiet window with nothing pending — restarted on every
        // DOM mutation and every image settling, so a slow-hydrating island
        // (e.g. the 3d canvas) keeps pushing the deadline out instead of the
        // loader vanishing before its images even exist yet.
        function scheduleSettleCheck() {
          if (quietTimer) clearTimeout(quietTimer)
          quietTimer = setTimeout(() => {
            let stillPending = false
            tracked.forEach((img) => { if (pending(img)) stillPending = true })
            if (stillPending) scheduleSettleCheck()
            else finish()
          }, 380)
        }

        function finish() {
          if (hidden) return
          hidden = true
          clearTimeout(maxTimer)
          if (quietTimer) clearTimeout(quietTimer)
          if (tickerTimer) clearInterval(tickerTimer)
          if (observer) observer.disconnect()
          setProgress(1)
          body.classList.remove("is-loading")
          requestAnimationFrame(() => loader.classList.add("is-hidden"))
          setTimeout(() => loader.remove(), 700)
        }

        scanImages()
        updateProgress()

        // Ignore mutations caused by the loader's own UI (e.g. the percentage
        // text node it rewrites on every tick) — otherwise updateProgress()
        // rewriting that text would retrigger this same observer forever.
        observer = new MutationObserver((mutations) => {
          const external = mutations.some((m) => !loader.contains(m.target))
          if (!external) return
          scanImages()
          updateProgress()
          scheduleSettleCheck()
        })
        observer.observe(document.body, { childList: true, subtree: true })

        Promise.resolve(document.fonts && document.fonts.ready).then(() => {
          scanImages()
          updateProgress()
          scheduleSettleCheck()
        })

        if (document.readyState === "complete") {
          scheduleSettleCheck()
        } else {
          window.addEventListener("load", () => {
            scanImages()
            updateProgress()
            scheduleSettleCheck()
          })
        }
      })()
    </script>

    <Navigator />
    <main class="relative z-10 mt-10 pointer-events-auto">
      <slot />
    </main>

    <!-- bottom-of-page spacer -->
    <footer class="site-foot" aria-hidden="true"></footer>

    <!-- ── right-click sitemap menu — replaces the native context menu with
         a small, in-world navigation tree so you can jump between pages
         (and expand into their subpages) without leaving the cursor ── -->
    <div id="site-context-menu" class="site-context-menu" role="menu" aria-hidden="true">
      <p class="scm-label">Sitemap</p>
      <div id="scm-tree" class="scm-tree"></div>
      <div class="scm-sep"></div>
      <p class="scm-here">you are here: <span id="scm-here-path">/</span></p>
    </div>
    <script is:inline>
      // scrollbars stay hidden until something scrolls: tag the scrolling
      // element with .is-scrolling, and drop it shortly after it settles
      (() => {
        const timers = new WeakMap()
        const show = (el, ms) => {
          el.classList.add("is-scrolling")
          clearTimeout(timers.get(el))
          timers.set(el, setTimeout(() => el.classList.remove("is-scrolling"), ms))
        }
        document.addEventListener(
          "scroll",
          (e) => show(e.target === document ? document.documentElement : e.target, 900),
          { capture: true, passive: true }
        )
        // nudging the pointer to the right edge brings the page's scrollbar back
        document.addEventListener(
          "pointermove",
          (e) => {
            if (e.clientX >= window.innerWidth - 16) show(document.documentElement, 900)
          },
          { passive: true }
        )
        // the big pages — work, about, and anything over two screens tall —
        // keep theirs on show the whole time
        const root = document.documentElement
        const measure = () => {
          const h = root.scrollHeight
          const vh = window.innerHeight
          const big = /^\/(work|about)(\/|$)/.test(location.pathname)
          root.classList.toggle("is-long", h > vh && (big || h > vh * 2))
        }
        new ResizeObserver(measure).observe(document.body)
        window.addEventListener("resize", measure, { passive: true })
        window.addEventListener("load", measure)
        document.addEventListener("astro:page-load", measure)
        measure()
      })()
