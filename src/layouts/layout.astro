    }

    .scm-sep {
      height: 1px;
      margin: 6px 0;
      background: var(--line);
    }

    .scm-here {
      font-family: var(--f-data);
      font-size: 11px;
      color: var(--soft);
      padding: 4px 14px 2px;
      margin: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  </style>

  <script>
    function setupCursor() {
      if (!window.matchMedia("(pointer: fine)").matches) return

      let el = document.getElementById("custom-cursor")
      if (!el) {
        el = document.createElement("div")
        el.id = "custom-cursor"
        document.body.appendChild(el)
      }
      if (!el.querySelector(".cursor-circle")) {
        const circle = document.createElement("div")
        circle.className = "cursor-circle"
        el.appendChild(circle)
      }

      let thought = document.getElementById("cursor-thought")
      if (!thought) {
        thought = document.createElement("div")
        thought.id = "cursor-thought"
        thought.style.position = "fixed"
        thought.style.top = "0"
        thought.style.left = "0"
        thought.innerHTML = `<span class="cursor-label" id="cursor-label-text">click</span>`
        document.body.appendChild(thought)
      }

      let raf = null

      // Elements clickable only via a JS listener (a row whose whole area
      // navigates, an image with a click-to-enlarge handler) don't carry a
      // native interactive tag, so they need an explicit hook here too —
      // otherwise the cursor never signals they're clickable.
      const HOVER_SELECTOR =
        "a, button:not(:disabled), [role=button], input, textarea, select, label, [tabindex], " +
        "[data-href], [data-cursor-click], .art-zoomable, .art-media-grid img"
      // Sample a small ring of points around the cursor (not just the exact
      // pixel under it) so hovering "near" a clickable target — its padding,
      // an icon's edge, a thin link — still registers as clickable. Widens
      // the effective touch/click area the cursor reacts to.
      const HOVER_RADIUS = 14
      const HOVER_OFFSETS = [
        [0, 0],
        [HOVER_RADIUS, 0], [-HOVER_RADIUS, 0], [0, HOVER_RADIUS], [0, -HOVER_RADIUS],
        [HOVER_RADIUS, HOVER_RADIUS], [-HOVER_RADIUS, HOVER_RADIUS],
        [HOVER_RADIUS, -HOVER_RADIUS], [-HOVER_RADIUS, -HOVER_RADIUS],
      ]

      /** @param {number} x @param {number} y */
      function findClickableNear(x, y) {
        for (const [dx, dy] of HOVER_OFFSETS) {
          const px = x + dx
          const py = y + dy
          if (px < 0 || py < 0 || px > window.innerWidth || py > window.innerHeight) continue
          const hit = document.elementFromPoint(px, py)
          const t = hit && hit.closest(HOVER_SELECTOR)
          if (t) return t
        }
        return null
      }

      document.addEventListener("mousemove", (e) => {
        if (raf) cancelAnimationFrame(raf)
        raf = requestAnimationFrame(() => {
          el.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`
          // label sits centered below the hover ring (inner .cursor-label
          // handles the horizontal -50% centering via CSS). The crosshair is
          // drawn at the middle of the 24px #custom-cursor box, so its center
          // is +12/+12 from the pointer; the 56px hover ring ends 28px below.
          thought.style.transform = `translate(${e.clientX + 12}px, ${e.clientY + 12 + 28 + 6}px)`

          const t = findClickableNear(e.clientX, e.clientY)
          el.classList.toggle("cursor--hover", !!t)
          thought.classList.toggle("visible", !!t)
          const labelText = document.getElementById("cursor-label-text")
          if (labelText) {
            const anchor = t && t.closest("a")
            const navigatesLikeLink = anchor || (t && t.hasAttribute("data-href"))
            const zoomable = t && (t.matches(".art-zoomable") || t.matches(".art-media-grid img"))
            labelText.textContent = navigatesLikeLink
              ? ((anchor || t).getAttribute("aria-label") || "open")
              : zoomable
              ? "enlarge"
              : (t ? (t.getAttribute("aria-label") || "click") : "")
          }
        })
      })

      // The cursor reads "clickable" anywhere inside that ring, so a click
      // there has to land too: when the pointer isn't exactly on a target but
      // the ring reaches one, forward the click to it.
      document.addEventListener("click", (e) => {
        if (!e.isTrusted || e.button !== 0) return
        if (e.target instanceof Element && e.target.closest(HOVER_SELECTOR)) return
        const t = findClickableNear(e.clientX, e.clientY)
        if (!(t instanceof HTMLElement)) return
        e.preventDefault()
        e.stopImmediatePropagation()
        if (t.matches("input, textarea, select")) t.focus()
        t.dispatchEvent(new MouseEvent("click", {
          bubbles: true, cancelable: true, view: window,
          clientX: e.clientX, clientY: e.clientY,
          ctrlKey: e.ctrlKey, metaKey: e.metaKey, shiftKey: e.shiftKey, altKey: e.altKey,
        }))
      }, true)
    }

    setupCursor()
    document.addEventListener("astro:page-load", setupCursor)
  </script>

  <script>
    // ── right-click sitemap menu ──
    // Suppresses the native browser context menu on right-click and shows a
    // small in-world "sitemap" at the cursor. Nodes with children open a
    // SIBLING panel next to their row — a cascading flyout submenu, the same
    // pattern as macOS/Finder/Explorer "New Folder ▸ Sort By ▸ Name" menus —
    // rather than expanding inline underneath themselves.

    let sitemapTreeCache = null // parsed once, reused across every menu open

    function makeLabel(node, currentPath) {
      if (node.path) {
        const a = document.createElement("a")
        a.className = "scm-link" + (node.path === currentPath ? " scm-current" : "")
        a.href = node.path
        a.dataset.path = node.path
        a.textContent = node.label
        return a
      }
      const span = document.createElement("span")
      span.className = "scm-link scm-nonlink"
      span.textContent = node.label
      return span
    }

    // fills `container` (a .scm-tree row list) with one row per node at this
    // level; rows with children get a "›" chevron and open a flyout on hover.
    function buildRows(container, nodes, level, currentPath, ctx) {
      for (const node of nodes) {
        const hasChildren = Array.isArray(node.children) && node.children.length > 0
        const row = document.createElement("div")
        row.className = "scm-row"
        row._scmNode = node
        row.appendChild(makeLabel(node, currentPath))

        if (hasChildren) {
          const chevron = document.createElement("span")
          chevron.className = "scm-chevron"
          chevron.textContent = "›"
          row.appendChild(chevron)
          row.addEventListener("mouseenter", () => ctx.openFlyout(node, row, level))
        } else {
          row.addEventListener("mouseenter", () => ctx.closeFlyoutsFrom(level + 1))
          row.addEventListener("click", () => ctx.hideMenu())
        }

        container.appendChild(row)
      }
    }

    function findChain(nodes, targetPath, trail) {
      for (const node of nodes) {
        if (node.path === targetPath) return trail
        if (Array.isArray(node.children)) {
          const found = findChain(node.children, targetPath, trail.concat([node]))
          if (found) return found
        }
      }
      return null
    }

    function setupContextMenu() {
      const menu = document.getElementById("site-context-menu")
      const treeRoot = document.getElementById("scm-tree")
      if (!menu || !treeRoot) return

      if (menu.dataset.bound === "1") return
      menu.dataset.bound = "1"

      // panels[0] is the static root menu; panels[1..] are dynamically
      // created/destroyed flyouts, one per open submenu level.
      const panels = [menu]
      const activeRows = []

      function normalizedPath() {
        return window.location.pathname.replace(/\/$/, "") || "/"
      }

      function closeFlyoutsFrom(level) {
        for (let l = panels.length - 1; l >= level; l--) {
          if (l > 0 && panels[l]) panels[l].remove()
          panels[l] = undefined
          if (activeRows[l - 1]) {
            activeRows[l - 1].classList.remove("scm-row-active")
            activeRows[l - 1] = undefined
          }
        }
        panels.length = Math.max(level, 1)
      }

      function positionFlyout(panel, anchorRow) {
        const parentPanel = anchorRow.closest(".site-context-menu")
        const parentRect = parentPanel.getBoundingClientRect()
        const anchorRect = anchorRow.getBoundingClientRect()
        const panelRect = panel.getBoundingClientRect()
        const OVERLAP = 4 // slight overlap, same as native cascading menus

        let left = parentRect.right - OVERLAP
        if (left + panelRect.width > window.innerWidth - 8) {
          left = parentRect.left - panelRect.width + OVERLAP // flip to the left edge
        }
        left = Math.max(8, left)

        let top = anchorRect.top - 8
        if (top + panelRect.height > window.innerHeight - 8) top = window.innerHeight - panelRect.height - 8
        top = Math.max(8, top)

        panel.style.left = `${left}px`
        panel.style.top = `${top}px`
      }

      function openFlyout(node, anchorRow, level) {
        if (panels[level + 1] && panels[level + 1].dataset.forNode === node.label && panels[level + 1]._scmParentRow === anchorRow) {
          return // already open for this exact row
        }
        closeFlyoutsFrom(level + 1)

        if (activeRows[level]) activeRows[level].classList.remove("scm-row-active")
        anchorRow.classList.add("scm-row-active")
        activeRows[level] = anchorRow

        const panel = document.createElement("div")
        panel.className = "site-context-menu scm-flyout"
        panel.dataset.forNode = node.label
        panel._scmParentRow = anchorRow
        panel.setAttribute("role", "menu")

        const inner = document.createElement("div")
        inner.className = "scm-tree"
        buildRows(inner, node.children, level + 1, normalizedPath(), ctx)
        panel.appendChild(inner)

        document.body.appendChild(panel)
        positionFlyout(panel, anchorRow)
        // force layout before adding .visible so the open transition plays
        void panel.offsetWidth
        panel.classList.add("visible")
        panels[level + 1] = panel
      }

      function autoExpandToCurrent(here) {
        if (!sitemapTreeCache) return
        const chain = findChain(sitemapTreeCache, here, [])
        if (!chain || !chain.length) return
        let container = treeRoot
        let level = 0
        for (const node of chain) {
          const row = Array.from(container.children).find((r) => r._scmNode === node)
          if (!row) break
          openFlyout(node, row, level)
          level++
          const nextPanel = panels[level]
          container = nextPanel && nextPanel.querySelector(".scm-tree")
          if (!container) break
        }
      }

      function markCurrentPath(here) {
        menu.querySelectorAll(".scm-link[data-path]").forEach((a) => {
          a.classList.toggle("scm-current", a.dataset.path === here)
        })
        const label = document.getElementById("scm-here-path")
        if (label) label.textContent = here
      }

      function hideMenu() {
        closeFlyoutsFrom(1)
        menu.classList.remove("visible")
        menu.setAttribute("aria-hidden", "true")
      }

      function showMenuAt(x, y) {
        const here = normalizedPath()
        markCurrentPath(here)
        menu.setAttribute("aria-hidden", "false")
        menu.classList.add("visible")

        // clamp inside viewport — measure after it's visible so offsetWidth/Height are real
        const { innerWidth, innerHeight } = window
        const rect = menu.getBoundingClientRect()
        const clampedX = Math.min(x, innerWidth - rect.width - 8)
        const clampedY = Math.min(y, innerHeight - rect.height - 8)
        menu.style.left = `${Math.max(8, clampedX)}px`
        menu.style.top = `${Math.max(8, clampedY)}px`

        autoExpandToCurrent(here)
      }

      const ctx = { openFlyout, closeFlyoutsFrom, hideMenu }

      if (treeRoot.dataset.built !== "1") {
        const dataEl = document.getElementById("sitemap-data")
        try {
          sitemapTreeCache = JSON.parse((dataEl && dataEl.textContent) || "[]")
        } catch {
          sitemapTreeCache = []
        }
        buildRows(treeRoot, sitemapTreeCache, 0, normalizedPath(), ctx)
        treeRoot.dataset.built = "1"
      }

      document.addEventListener("contextmenu", (e) => {
        // let the browser's native menu through on real inputs/text selection
        const target = e.target
        if (target && target.closest && target.closest("input, textarea, [contenteditable='true']")) return
        e.preventDefault()
        showMenuAt(e.clientX, e.clientY)
      })

      document.addEventListener("click", (e) => {
        if (!menu.classList.contains("visible")) return
        const t = e.target
        if (t instanceof Node && panels.some((p) => p && p.contains(t))) return
        hideMenu()
      })

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") hideMenu()
      })
    }

    setupContextMenu()
    document.addEventListener("astro:page-load", setupContextMenu)
  </script>
  </body>
</html>
