---
import { SEO } from "astro-seo"
import Navigator from "../components/navigator.jsx"
import "@fontsource/jetbrains-mono/100.css"
import "@fontsource/jetbrains-mono/200.css"
import "@fontsource/jetbrains-mono/300.css"
import "@fontsource/jetbrains-mono/400.css"
import "@fontsource/jetbrains-mono/500.css"
import "@fontsource/jetbrains-mono/600.css"
import "@fontsource/jetbrains-mono/700.css"

export interface Props {
  title?: string
  preview?: string
  description?: string
}

const { title, preview, description } = Astro.props
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description=""
      openGraph={{
        basic: {
          title: title || "",
          image: preview || "",
          type: "website",
        },
      }}
    />
    <title>{title}</title>
  </head>
  <body>
    <Navigator client:load />
    <main class="relative z-10 mt-16 pointer-events-auto">
      <slot />
    </main>
    <style is:global>
      :root {
        --bg: #000000;
        --bg-elevated: #0d0d0d;
        --text: #e8e8e8;
        --text-muted: #737373;
        --text-dim: #404040;
        --border: #262626;
        --border-subtle: #1a1a1a;
      }

      html,
      body {
        background-color: var(--bg);
        color: var(--text-muted);
        font-family: "JetBrains Mono", monospace;
        -webkit-font-smoothing: antialiased;
      }

      main {
        color: var(--text-muted);
      }

      h1,
      h2,
      h3 {
        color: var(--text);
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      a {
        color: var(--text-muted);
        text-decoration: none;
      }

      a:hover {
        color: var(--text);
      }

      nav {
        pointer-events: auto;
      }

      ::selection {
        background: #333;
        color: #fff;
      }

      .opacity-80 {
        opacity: 1;
        color: var(--text-dim);
      }

      .border-gray-700,
      .border-neutral-800,
      .border-neutral-200 {
        border-color: var(--border) !important;
      }

      figcaption {
        color: var(--text-dim);
      }
    </style>
  <script>
    // Prevent bfcache from restoring stale Astro island hydration states,
    // which causes React roots to mount a second time into an already-rendered container.
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) {
        window.location.reload()
      }
    })
  </script>
  </body>
</html>
