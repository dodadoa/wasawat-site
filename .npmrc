public-hoist-pattern[]=*react*
public-hoist-pattern[]=*react-dom*

# Supply-chain hardening (moved from pnpm-workspace.yaml, which broke
# Vercel's pnpm 9 install by looking like a workspace manifest).
# Wait 7 days before installing newly published versions.
minimum-release-age=10080
# Fail install if a package's trust signals weaken vs previous releases.
trust-policy=no-downgrade
